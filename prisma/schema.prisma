model DialysisSessionConsumable {
  id              String   @id @default(uuid())
  sessionId       String
  consumableId    String
  storeLocationId String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoiceItem     InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId   String?
  usageEvent      ConsumableUsageEvent? @relation(fields: [usageEventId], references: [id], onDelete: SetNull)
  usageEventId    String?
  createdAt       DateTime @default(now())
  createdBy       Staff?   @relation("DialysisSessionConsumableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById     String?

  session       DialysisSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  consumable    Consumable       @relation(fields: [consumableId], references: [id], onDelete: Restrict)
  storeLocation StoreLocation    @relation(fields: [storeLocationId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([consumableId])
  @@index([storeLocationId])
}

model LabOrderItem {
  id            String   @id @default(uuid())
  orderId       String
  testVersionId String
  status        String   @default("PENDING") // PENDING, SAMPLE_COLLECTED, PROCESSING, COMPLETED, VERIFIED
  /// When true, Antibiotic Susceptibility Testing (AST) may be recorded for this line (e.g. MCS).
  astRequested  Boolean  @default(false)
  createdAt     DateTime @default(now())

  order       LabOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  testVersion LabTestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)
  sample      LabSample?
  results     LabResult[]
  astResults  LabAstResult[]

  @@index([orderId])
  @@index([testVersionId])
  @@index([astRequested])
}

model LabAntibiotic {
  id        String   @id @default(uuid())
  name      String
  code      String?
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  astResults LabAstResult[]

  @@unique([name])
  @@index([isActive])
  @@index([position])
}

model LabAstResultOption {
  id        String   @id @default(uuid())
  label     String
  code      String?
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  astResults LabAstResult[]

  @@unique([label])
  @@index([isActive])
  @@index([position])
}

model LabAstResult {
  id             String   @id @default(uuid())
  orderItemId    String
  antibioticId   String
  resultOptionId String
  enteredById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItem    LabOrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  antibiotic   LabAntibiotic      @relation(fields: [antibioticId], references: [id], onDelete: Restrict)
  resultOption LabAstResultOption @relation(fields: [resultOptionId], references: [id], onDelete: Restrict)
  enteredBy    Staff              @relation("LabAstResultEnteredBy", fields: [enteredById], references: [id], onDelete: Restrict)

  @@unique([orderItemId, antibioticId])
  @@index([orderItemId])
  @@index([antibioticId])
  @@index([resultOptionId])
}

model LabSample {
  id             String   @id @default(uuid())
  orderItemId    String
  sampleType     String
  collectedById  String
  collectionTime DateTime
  barcode        String?
  createdAt      DateTime @default(now())

  orderItem   LabOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  collectedBy Staff        @relation("LabSampleCollectedBy", fields: [collectedById], references: [id], onDelete: Restrict)

  @@unique([orderItemId])
  @@index([orderItemId])
}

model LabResult {
  id           String           @id @default(uuid())
  orderItemId  String
  fieldId      String
  value        String?
  enteredById  String
  abnormalFlag LabAbnormalFlag?
  isCritical   Boolean          @default(false)
  evaluatedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  orderItem LabOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  field     LabTestField @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  enteredBy Staff        @relation("LabResultEnteredBy", fields: [enteredById], references: [id], onDelete: Restrict)

  @@unique([orderItemId, fieldId])
  @@index([orderItemId])
  @@index([fieldId])
  @@index([isCritical, createdAt])
}

model NurseAssignment {
  id          String    @id @default(uuid())
  nurse       Staff     @relation("NurseAssignmentNurse", fields: [nurseId], references: [id])
  nurseId     String
  admission   Admission @relation(fields: [admissionId], references: [id])
