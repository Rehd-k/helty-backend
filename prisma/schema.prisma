// Prisma schema for hospital management system

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum PatientStatus {
  ADMITED
  DECEASED
  OUTPATIENT
}

// patient model with extended fields
model Patient {
  id                    String        @id @default(uuid())
  patientId             String?       @unique
  title                 String?
  cardNo                String?
  surname               String?
  firstName             String?
  otherName             String?
  dob                   DateTime?
  gender                String?
  maritalStatus         String?
  nationality           String?
  stateOfOrigin         String?
  lga                   String?
  town                  String?
  permanentAddress      String?
  religion              String?
  email                 String?
  preferredLanguage     String?
  phoneNumber           String?       @unique
  addressOfResidence    String?
  profession            String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinAddress      String?
  nextOfKinRelationship String?
  hmo                   String?
  hmoId                 String?
  fingerprintData       String?
  avatarUrl             String?
  status                PatientStatus @default(OUTPATIENT)
  /** Lowercased concat of firstName + otherName + surname for multi-word search. */
  searchName            String?       @db.Text

  hmoProvider Hmo? @relation(fields: [hmoId], references: [id])

  appointments             Appointment[]
  appointmentNotifications AppointmentNotification[]
  admissions               Admission[]
  payments                 Payment[]
  wallet                   PatientWallet?
  medicalHistories         MedicalHistory[]
  doctorReports            DoctorReport[]
  labReports               LabReport[]
  radiologyReports         RadiologyReport[]
  prescriptions            Prescription[]
  invoice                  Invoice[]
  patientVitals            PatientVitals[]
  allergies                PatientAllergy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy       Staff            @relation("PatientCreatedBy", fields: [createdById], references: [id])
  createdById     String
  updatedBy       Staff?           @relation("PatientUpdatedBy", fields: [updatedById], references: [id])
  updatedById     String?
  waitingPatients WaitingPatient[]
  encounters      Encounter[]
  labRequests        LabRequest[]
  medicationRequests MedicationRequest[]

  wardId String?
  ward   Ward?   @relation(fields: [wardId], references: [id])

  pregnancies               Pregnancy[]
  babiesAsMother            Baby[]
  babiesRegisteredAsPatient Baby[]                     @relation("BabyRegisteredPatient")
  gynaeProcedures           GynaeProcedure[]
  surgeryRequests           SurgeryRequest[]
  postnatalVisitsAsSubject  PostnatalVisit[]
  labOrders                 LabOrder[]
  dialysisSessions          DialysisSession[]
  radiologyOrders           RadiologyOrder[]
  medicationOrders          MedicationOrder[]
  consumableUsageEvents     ConsumableUsageEvent[]
  archivedEncounters        PatientArchivedEncounter[]
  referrals                 Referral[]
  complaints                PatientComplaint[]
  feedbackSubmissions       PatientFeedback[]
  emergencyRequests         EmergencyRequest[]
  safetyIncidents           SafetyIncident[]
  infectionCases            InfectionCase[]
  medicationDoseLogs        PatientMedicationDoseLog[]
  prescriptionRefillRequests PrescriptionRefillRequest[]
  devices                    PatientDevice[]
  childrenAsParent           PatientFamilyLink[] @relation("FamilyParent")
  parentsAsChild             PatientFamilyLink[] @relation("FamilyChild")

  @@index([hmoId])
  @@index([searchName])
}

enum PatientDeviceStatus {
  PENDING
  APPROVED
}

model PatientDevice {
  id           String              @id @default(uuid())
  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId    String
  deviceKey    String              @unique
  platform     String?
  deviceLabel  String?
  fcmToken     String?             @unique
  status       PatientDeviceStatus @default(PENDING)
  approvedAt   DateTime?
  approvedBy   Staff?              @relation("PatientDeviceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById String?
  lastSeenAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([patientId])
  @@index([patientId, status])
  @@index([status])
}

model PatientFamilyLink {
  id              String   @id @default(uuid())
  parent          Patient  @relation("FamilyParent", fields: [parentPatientId], references: [id], onDelete: Cascade)
  parentPatientId String
  child           Patient  @relation("FamilyChild", fields: [childPatientId], references: [id], onDelete: Cascade)
  childPatientId  String
  createdBy       Staff    @relation("FamilyLinkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([parentPatientId, childPatientId])
  @@index([parentPatientId])
  @@index([childPatientId])
}

// ─── ICD-10 (optional: for diagnosis tab search; or use external API) ───────────

model Icd10Code {
  id          String    @id @default(uuid())
  code        String    @unique
  description String
  specialty   String
  icdGroup    String    @map("icd_group")
  range       String
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  @@index([code])
  @@index([description])
  @@index([specialty])
  @@index([icdGroup])
  @@index([specialty, icdGroup])
}

enum AppointmentNotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum AppointmentNotificationKind {
  CREATED
  RESCHEDULED
  CANCELLED
  REMINDER_DAY_OF
  REMINDER_DAY_BEFORE
}

enum CustomPushTargetType {
  ALL
  SELECTED
}

model HealthCampaign {
  id          String    @id @default(uuid())
  title       String
  body        String
  imageUrl    String?
  publishedAt DateTime?
  expiresAt   DateTime?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   Staff     @relation("HealthCampaignCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?    @relation("HealthCampaignUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  @@index([isPublished, publishedAt])
  @@index([expiresAt])
}

model HealthNewsArticle {
  id          String    @id @default(uuid())
  title       String
  body        String
  imageUrl    String?
  publishedAt DateTime?
  expiresAt   DateTime?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   Staff     @relation("HealthNewsArticleCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?    @relation("HealthNewsArticleUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  @@index([isPublished, publishedAt])
  @@index([expiresAt])
}

model SystemAnnouncement {
  id          String    @id @default(uuid())
  title       String
  description String
  iconKey     String    @default("info")
  isActive    Boolean   @default(false)
  sortOrder   Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   Staff     @relation("SystemAnnouncementCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?    @relation("SystemAnnouncementUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  @@index([isActive, sortOrder])
  @@index([expiresAt])
}

model CustomPushNotification {
  id            String               @id @default(uuid())
  title         String
  body          String
  imageUrl      String?
  targetType    CustomPushTargetType
  patientIds    Json
  sentBy        Staff                @relation("CustomPushSentBy", fields: [sentById], references: [id])
  sentById      String
  successCount  Int                  @default(0)
  failureCount  Int                  @default(0)
  createdAt     DateTime             @default(now())

  @@index([sentById])
  @@index([createdAt])
}

enum AppointmentNotificationStatus {
  PENDING
  SKIPPED_CONFIG
  SKIPPED_NO_CONTACT
  SENT
  FAILED
}

enum AppointmentVisitType {
  IN_PERSON
  TELEMEDICINE
}

model Appointment {
  id        String   @id @default(uuid())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId String
  date      DateTime
  status    String
  reason    String?
  notes     String?
  location  String?
  referral  String?
  /// MedicalSpecialty enum value when patient requests without a doctor.
  specialty String?
  visitType AppointmentVisitType @default(IN_PERSON)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  encounters    Encounter[]
  notifications AppointmentNotification[]

  createdBy   Staff   @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  @@index([status])
  @@index([specialty])
  @@index([visitType])
}

model AppointmentNotification {
  id                String                         @id @default(uuid())
  appointment       Appointment                    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId     String
  patient           Patient                        @relation(fields: [patientId], references: [id])
  patientId         String
  channel           AppointmentNotificationChannel
  kind              AppointmentNotificationKind
  idempotencyKey    String                         @unique
  scheduledFor      DateTime?
  sentAt            DateTime?
  status            AppointmentNotificationStatus  @default(PENDING)
  provider          String?
  providerMessageId String?
  errorMessage      String?
  payloadSnapshot   Json?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  @@index([appointmentId])
  @@index([patientId])
  @@index([kind, status])
}

model Admission {
  id            String     @id @default(uuid())
  patient       Patient    @relation(fields: [patientId], references: [id])
  patientId     String
  encounter     Encounter? @relation("AdmissionEncounter")
  admissionDate DateTime
  dischargeDate DateTime?
  ward          String?
  room          String?
  reason        String?
  createdAt     DateTime   @default(now())

  // Enhanced inpatient structure (keep legacy fields above for compatibility)
  admissionDateTime  DateTime        @default(now())
  admittedByDoctor   Staff?          @relation("AdmissionAdmittedByDoctor", fields: [admittedByDoctorId], references: [id])
  admittedByDoctorId String?
  wardEntity         Ward?           @relation("WardAdmissions", fields: [wardId], references: [id])
  wardId             String?
  bed                Bed?            @relation("BedAdmissions", fields: [bedId], references: [id])
  bedId              String?
  primaryDiagnosis   String?
  admissionReason    String?
  admissionType      AdmissionType?
  status             AdmissionStatus @default(ACTIVE)
  dischargeDateTime  DateTime?
  dischargeSummary   String?
  outcome            String?

  clinicallyDischargedAt   DateTime?
  clinicallyDischargedBy   Staff?    @relation("AdmissionClinicallyDischargedBy", fields: [clinicallyDischargedById], references: [id])
  clinicallyDischargedById String?
  billingClearedAt         DateTime?
  billingClearedBy         Staff?    @relation("AdmissionBillingClearedBy", fields: [billingClearedById], references: [id])
  billingClearedById       String?
  nursesClearedAt          DateTime?
  nursesClearedBy          Staff?    @relation("AdmissionNursesClearedBy", fields: [nursesClearedById], references: [id])
  nursesClearedById        String?

  wardHistory               AdmissionWardHistory[]
  nurseAssignments          NurseAssignment[]
  medicationOrders          MedicationOrder[]
  medicationAdministrations MedicationAdministration[]
  ivFluidOrders             IVFluidOrder[]
  ivMonitorings             IVMonitoring[]
  intakeOutputRecords       IntakeOutputRecord[]
  nursingNotes              NursingNote[]
  procedureRecords          ProcedureRecord[]
  woundAssessments          WoundAssessment[]
  carePlans                 CarePlan[]
  monitoringCharts          MonitoringChart[]
  handoverReports           HandoverReport[]
  alerts                    AlertLog[]
  auditTrails               AuditTrail[]
  patientVitals             PatientVitals[]
  wardRoundNotes            WardRoundNote[]
  labourDeliveries          LabourDelivery[]           @relation("AdmissionLabourDeliveries")
  gynaeProcedures           GynaeProcedure[]
  surgeryRequests           SurgeryRequest[]

  attendingDoctor   Staff?  @relation("AdmissionAttendingDoctor", fields: [attendingDoctorId], references: [id])
  attendingDoctorId String?

  consumableUsageEvents ConsumableUsageEvent[]
  referrals             Referral[]
  safetyIncidents       SafetyIncident[]
  infectionCases        InfectionCase[]
  prescriptions         Prescription[]
  labRequests           LabRequest[]
  labOrders             LabOrder[]
  radiologyOrders       RadiologyOrder[]
  medicationRequests    MedicationRequest[]

  createdBy   Staff   @relation("AdmissionCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("AdmissionUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  @@index([patientId])
  @@index([status])
  @@index([attendingDoctorId])
}

model AdmissionWardHistory {
  id          String    @id @default(uuid())
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  admissionId String
  fromWard    Ward?     @relation("AdmissionWardHistoryFrom", fields: [fromWardId], references: [id], onDelete: SetNull)
  fromWardId  String?
  toWard      Ward?     @relation("AdmissionWardHistoryTo", fields: [toWardId], references: [id], onDelete: SetNull)
  toWardId    String?
  fromBed     Bed?      @relation("AdmissionWardHistoryFromBed", fields: [fromBedId], references: [id], onDelete: SetNull)
  fromBedId   String?
  toBed       Bed?      @relation("AdmissionWardHistoryToBed", fields: [toBedId], references: [id], onDelete: SetNull)
  toBedId     String?
  reason      String?
  changedAt   DateTime  @default(now())
  changedBy   Staff?    @relation("AdmissionWardHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedById String?
  createdAt   DateTime  @default(now())

  @@index([admissionId])
  @@index([toWardId])
  @@index([changedAt])
}

model Payment {
  id          String   @id @default(uuid())
  patient     Patient  @relation(fields: [patientId], references: [id])
  patientId   String
  amount      Float
  method      String
  description String?
  date        DateTime @default(now())

  createdBy   Staff   @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("PaymentUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
  bank        Bank?   @relation(fields: [bankId], references: [id])
  bankId      String?
}

model MedicalHistory {
  id        String   @id @default(uuid())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId String
  details   String
  createdAt DateTime @default(now())

  createdBy   Staff   @relation("MedicalHistoryCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("MedicalHistoryUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
}

model DoctorReport {
  id          String     @id @default(uuid())
  patient     Patient    @relation(fields: [patientId], references: [id])
  patientId   String
  encounter   Encounter? @relation(fields: [encounterId], references: [id])
  encounterId String?
  doctorId    String?
  report      String
  createdAt   DateTime   @default(now())

  createdBy   Staff   @relation("DoctorReportCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("DoctorReportUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
}

model LabReport {
  id          String     @id @default(uuid())
  patient     Patient    @relation(fields: [patientId], references: [id])
  patientId   String
  encounter   Encounter? @relation(fields: [encounterId], references: [id])
  encounterId String?
  reportType  String
  results     String
  date        DateTime   @default(now())

  createdBy   Staff   @relation("LabReportCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("LabReportUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
}

model RadiologyReport {
  id          String     @id @default(uuid())
  patient     Patient    @relation(fields: [patientId], references: [id])
  patientId   String
  encounter   Encounter? @relation(fields: [encounterId], references: [id])
  encounterId String?
  reportType  String
  results     String
  date        DateTime   @default(now())

  createdBy   Staff   @relation("RadiologyReportCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("RadiologyReportUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
}

model Prescription {
  id          String     @id @default(uuid())
  patient     Patient    @relation(fields: [patientId], references: [id])
  patientId   String
  encounter   Encounter? @relation(fields: [encounterId], references: [id])
  encounterId String?
  admission   Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  admissionId String?
  ward        Ward?      @relation("PrescriptionRequestWard", fields: [wardId], references: [id], onDelete: SetNull)
  wardId      String?
  // Legacy simple fields (kept nullable for backward compatibility)
  drug        String?
  dosage      String?
  startDate   DateTime?
  endDate     DateTime?
  notes       String?

  // Pharmacy domain extensions
  type     PrescriptionType   @default(OUTPATIENT)
  status   PrescriptionStatus @default(PENDING)
  doctor   Staff?             @relation("PrescriptionDoctor", fields: [doctorId], references: [id])
  doctorId String?

  refillsAllowed Int @default(0)

  items         PrescriptionItem[]
  dispensations Dispensation[]
  refillRequests PrescriptionRefillRequest[]

  createdBy   Staff   @relation("PrescriptionCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("PrescriptionUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  @@index([admissionId])
  @@index([wardId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHARMACY DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

enum PharmacyLocationType {
  STORE
  DISPENSARY
}

enum InventoryMovementType {
  PURCHASE
  TRANSFER_OUT
  TRANSFER_IN
  DISPENSE
  ADJUSTMENT
  RETURN
  EXPIRY_WRITEOFF
}

enum MovementReferenceType {
  PURCHASE_ORDER
  TRANSFER
  DISPENSATION
  ADJUSTMENT
  INVOICE_ITEM
  CONSUMABLE_USAGE_EVENT
}

enum ConsumableAllocationDirection {
  OUT
  IN
}

enum ConsumableUsageDirection {
  USE
  RETURN
}

enum ConsumableUsageSource {
  NURSING
  ENCOUNTER_PROCEDURE
  THEATRE
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  RECEIVED
  CANCELLED
}

enum StockTransferStatus {
  PENDING
  APPROVED
  COMPLETED
}

enum PrescriptionType {
  OUTPATIENT
  INPATIENT
}

enum PrescriptionStatus {
  PENDING
  PARTIALLY_DISPENSED
  COMPLETED
  CANCELLED
}

enum DispensationStatus {
  DRAFT
  COMPLETED
  REVERSED
}

enum PrescriptionItemType {
  DRUG
  CONSUMABLE
}

enum PatientMedicationDoseStatus {
  UPCOMING
  TAKEN
  MISSED
  SKIPPED
}

enum MedicationTimeOfDay {
  MORNING
  AFTERNOON
  EVENING
}

enum PrescriptionRefillRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

model Manufacturer {
  id          String   @id @default(uuid())
  name        String
  country     String?
  contactInfo Json?
  createdAt   DateTime @default(now())

  drugs Drug[]
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  licenseNumber String?
  contactInfo   Json?
  creditTerms   String?
  leadTimeDays  Int?
  rating        Int?
  isBlacklisted Boolean  @default(false)
  createdAt     DateTime @default(now())

  batches        DrugBatch[]
  purchaseOrders PurchaseOrder[]
}

model Drug {
  id               String        @id @default(uuid())
  genericName      String
  searviceCode     String
  brandName        String
  strength         String?
  dosageForm       String?
  route            String?
  therapeuticClass String?
  atcCode          String?
  manufacturer     Manufacturer? @relation(fields: [manufacturerId], references: [id])
  manufacturerId   String?
  isControlled     Boolean       @default(false)
  isRefrigerated   Boolean       @default(false)
  isHighAlert      Boolean       @default(false)
  maxDailyDose     Decimal?      @db.Decimal(10, 2)
  reorderLevel     Int           @default(0)
  reorderQuantity  Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  batches            DrugBatch[]
  interactionsA      DrugInteraction[]   @relation("DrugInteractionA")
  interactionsB      DrugInteraction[]   @relation("DrugInteractionB")
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  prescriptionItems  PrescriptionItem[]
  inventoryMovements InventoryMovement[]

  createdBy          Staff               @relation("DrugCreatedBy", fields: [createdById], references: [id])
  createdById        String
  updatedBy          Staff?              @relation("DrugUpdatedBy", fields: [updatedById], references: [id])
  updatedById        String?
  medicationOrders           MedicationOrder[] @relation("MedicationOrderCurrentDrug")
  prescribedMedicationOrders MedicationOrder[] @relation("MedicationOrderPrescribedDrug")
  invoiceItems            InvoiceItem[]
  invoiceDrugReturns      InvoiceDrugReturn[]
  drugPrices              DrugPrice[]
  dispenseBatchAllocations DispenseBatchAllocation[]
  clinicalServicePackageItems ClinicalServicePackageItem[]

  @@index([manufacturerId])
  @@index([isControlled])
}

model DrugPrice {
  id        String   @id @default(uuid())
  drug      Drug     @relation(fields: [drugId], references: [id])
  drugId    String
  ward      Ward     @relation(fields: [wardId], references: [id])
  wardId    String
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([drugId, wardId])
}

model DrugInteraction {
  id       String @id @default(uuid())
  drugA    Drug   @relation("DrugInteractionA", fields: [drugAId], references: [id])
  drugAId  String
  drugB    Drug   @relation("DrugInteractionB", fields: [drugBId], references: [id])
  drugBId  String
  severity String

  @@unique([drugAId, drugBId])
}

model Consumable {
  id           String   @id @default(uuid())
  name         String
  category     String?
  reorderLevel Int?
  isBillable   Boolean  @default(true)
  createdAt    DateTime @default(now())

  batches           ConsumableBatch[]
  prescriptionItems PrescriptionItem[]
  movements         ConsumableMovement[]
  invoiceItems             InvoiceItem[]
  usageEvents              ConsumableUsageEvent[]
  dialysisSessionConsumables DialysisSessionConsumable[]
  theatreCaseConsumables     TheatreCaseConsumable[]
}

model DrugBatch {
  id                String           @id @default(uuid())
  drug              Drug             @relation(fields: [drugId], references: [id])
  drugId            String
  fromLocation      PharmacyLocation @relation("DrugBatchFromLocation", fields: [fromLocationId], references: [id])
  fromLocationId    String
  toLocation        PharmacyLocation @relation("DrugBatchToLocation", fields: [toLocationId], references: [id])
  toLocationId      String
  batchNumber       String
  manufacturingDate DateTime
  expiryDate        DateTime
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  supplierId        String?
  costPrice         Decimal          @db.Decimal(12, 2)
  sellingPrice      Decimal          @db.Decimal(12, 2)
  quantityReceived  Int
  quantityRemaining Int
  grn               GoodsReceipt?    @relation(fields: [grnId], references: [id])
  grnId             String?
  createdAt         DateTime         @default(now())

  movements                InventoryMovement[]
  transferItems            StockTransferItem[]
  dispensationItems        DispensationItem[]
  dispenseBatchAllocations DispenseBatchAllocation[]

  @@index([drugId, fromLocationId, toLocationId])
  @@index([expiryDate])
  @@index([supplierId])
  @@index([manufacturingDate])
}

model InventoryMovement {
  id             String                @id @default(uuid())
  batch          DrugBatch             @relation(fields: [batchId], references: [id])
  batchId        String
  drug           Drug                  @relation(fields: [drugId], references: [id])
  drugId         String
  fromLocation   PharmacyLocation      @relation("InventoryMovementFromLocation", fields: [fromLocationId], references: [id])
  fromLocationId String
  toLocation     PharmacyLocation      @relation("InventoryMovementToLocation", fields: [toLocationId], references: [id])
  toLocationId   String
  movementType   InventoryMovementType
  quantity       Int
  referenceType  MovementReferenceType
  referenceId    String
  performedBy    Staff                 @relation("InventoryMovementPerformedBy", fields: [performedById], references: [id])
  performedById  String
  createdAt      DateTime              @default(now())
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Decimal             @db.Decimal(12, 2)
  createdBy    Staff               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdById  String
  approvedBy   Staff?              @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  approvedById String?
  createdAt    DateTime            @default(now())

  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String
  drug            Drug          @relation(fields: [drugId], references: [id])
  drugId          String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  expectedExpiry  DateTime?
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String
  receivedBy      Staff         @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  receivedById    String
  receivedAt      DateTime      @default(now())

  items   GoodsReceiptItem[]
  batches DrugBatch[]
}

model GoodsReceiptItem {
  id                String       @id @default(uuid())
  goodsReceipt      GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  goodsReceiptId    String
  drug              Drug         @relation(fields: [drugId], references: [id])
  drugId            String
  batchNumber       String
  manufacturingDate DateTime
  expiryDate        DateTime
  quantityReceived  Int
  costPrice         Decimal      @db.Decimal(12, 2)
}

model StockTransfer {
  id             String           @id @default(uuid())
  fromLocation   PharmacyLocation @relation("StockTransferFromLocation", fields: [fromLocationId], references: [id])
  fromLocationId String
  toLocation     PharmacyLocation @relation("StockTransferToLocation", fields: [toLocationId], references: [id])
  toLocationId   String

  status       StockTransferStatus @default(PENDING)
  createdBy    Staff               @relation("StockTransferCreatedBy", fields: [createdById], references: [id])
  createdById  String
  approvedBy   Staff?              @relation("StockTransferApprovedBy", fields: [approvedById], references: [id])
  approvedById String?
  createdAt    DateTime            @default(now())
  completedAt  DateTime?

  items StockTransferItem[]
}

model StockTransferItem {
  id              String        @id @default(uuid())
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id])
  stockTransferId String
  batch           DrugBatch     @relation(fields: [batchId], references: [id])
  batchId         String
  quantity        Int
}

model PrescriptionItem {
  id                 String               @id @default(uuid())
  prescription       Prescription         @relation(fields: [prescriptionId], references: [id])
  prescriptionId     String
  itemType           PrescriptionItemType
  drug               Drug?                @relation(fields: [drugId], references: [id])
  drugId             String?
  consumable         Consumable?          @relation(fields: [consumableId], references: [id])
  consumableId       String?
  dosage             String
  frequency          String?
  duration           Int?
  quantityPrescribed Int
  quantityDispensed  Int                  @default(0)
  instructions       String?

  dispensationItems DispensationItem[]
  doseLogs          PatientMedicationDoseLog[]

  @@index([prescriptionId])
  @@index([drugId])
}

model PatientMedicationDoseLog {
  id                 String                      @id @default(uuid())
  patient            Patient                     @relation(fields: [patientId], references: [id])
  patientId          String
  prescriptionItem   PrescriptionItem            @relation(fields: [prescriptionItemId], references: [id])
  prescriptionItemId String
  scheduledAt        DateTime
  timeOfDay          MedicationTimeOfDay
  status             PatientMedicationDoseStatus @default(UPCOMING)
  takenAt            DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([prescriptionItemId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([prescriptionItemId])
  @@index([status])
}

model PrescriptionRefillRequest {
  id                String                          @id @default(uuid())
  prescription      Prescription                    @relation(fields: [prescriptionId], references: [id])
  prescriptionId    String
  patient           Patient                         @relation(fields: [patientId], references: [id])
  patientId         String
  status            PrescriptionRefillRequestStatus @default(PENDING)
  notes             String?
  pharmacyNotes     String?
  reviewedBy        Staff?                          @relation("PrescriptionRefillReviewedBy", fields: [reviewedByStaffId], references: [id])
  reviewedByStaffId String?
  reviewedAt        DateTime?
  invoiceItem       InvoiceItem?                    @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId     String?                         @unique
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  @@index([prescriptionId, status])
  @@index([patientId])
  @@index([status, createdAt])
}

model PharmacyLocation {
  id                     String               @id @default(uuid())
  name                   String
  locationType           PharmacyLocationType
  description            String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  createdBy              Staff                @relation("PharmacyLocationCreatedBy", fields: [createdById], references: [id])
  createdById            String
  updatedBy              Staff?               @relation("PharmacyLocationUpdatedBy", fields: [updatedById], references: [id])
  updatedById            String?
  drugBatchesFrom        DrugBatch[]          @relation("DrugBatchFromLocation")
  drugBatchesTo          DrugBatch[]          @relation("DrugBatchToLocation")
  inventoryMovementsFrom InventoryMovement[]  @relation("InventoryMovementFromLocation")
  inventoryMovementsTo   InventoryMovement[]  @relation("InventoryMovementToLocation")
  stockTransfersFrom     StockTransfer[]      @relation("StockTransferFromLocation")
  stockTransfersTo       StockTransfer[]      @relation("StockTransferToLocation")
  dispensations          Dispensation[]
  staff                  Staff?               @relation("PharmacyLocationStaff", fields: [staffId], references: [id])
  staffId                String?              @unique
  invoiceDrugReturns     InvoiceDrugReturn[]  @relation("InvoiceDrugReturnDispensary")
  invoiceItemsDispensed       InvoiceItem[]             @relation("InvoiceItemDispensary")
  medicationAdministrations   MedicationAdministration[]
  dispenseBatchAllocations    DispenseBatchAllocation[]
}

model Dispensation {
  id             String               @id @default(uuid())
  prescription   Prescription         @relation(fields: [prescriptionId], references: [id])
  prescriptionId String
  location       PharmacyLocation     @relation(fields: [locationId], references: [id])
  locationId     String
  locationType   PharmacyLocationType @default(DISPENSARY)
  pharmacist     Staff                @relation("DispensationPharmacist", fields: [pharmacistId], references: [id])
  pharmacistId   String
  status         DispensationStatus   @default(DRAFT)
  createdAt      DateTime             @default(now())

  items                    DispensationItem[]
  approvals                ControlledApproval[]
  dispenseBatchAllocations DispenseBatchAllocation[]
}

/// FIFO batch depletion snapshot for each dispensed invoice drug line (profit reporting).
model DispenseBatchAllocation {
  id               String            @id @default(cuid())
  invoiceItem      InvoiceItem       @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  invoiceItemId    String
  dispensation     Dispensation?     @relation(fields: [dispensationId], references: [id], onDelete: SetNull)
  dispensationId   String?
  drug             Drug              @relation(fields: [drugId], references: [id])
  drugId           String
  batch            DrugBatch         @relation(fields: [batchId], references: [id])
  batchId          String
  location         PharmacyLocation  @relation(fields: [locationId], references: [id])
  locationId       String
  quantity         Int
  unitCost         Decimal           @db.Decimal(12, 2)
  unitSellingPrice Decimal           @db.Decimal(12, 2)
  payerType        String?
  dispensedBy      Staff?            @relation("DispenseBatchAllocationDispensedBy", fields: [dispensedById], references: [id])
  dispensedById    String?
  dispensedAt      DateTime
  createdAt        DateTime          @default(now())

  @@index([dispensedAt])
  @@index([locationId, dispensedAt])
  @@index([drugId, dispensedAt])
  @@index([batchId])
  @@index([invoiceItemId])
}

model DispensationItem {
  id                 String           @id @default(uuid())
  dispensation       Dispensation     @relation(fields: [dispensationId], references: [id])
  dispensationId     String
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  prescriptionItemId String
  batch              DrugBatch?       @relation(fields: [batchId], references: [id])
  batchId            String?
  quantityDispensed  Int
}

model ControlledApproval {
  id             String       @id @default(uuid())
  dispensation   Dispensation @relation(fields: [dispensationId], references: [id])
  dispensationId String
  approver       Staff        @relation("ControlledApprovalApprover", fields: [approverId], references: [id])
  approverId     String
  approvedAt     DateTime     @default(now())
}

model ConsumableBatch {
  id                String        @id @default(uuid())
  consumable        Consumable    @relation(fields: [consumableId], references: [id])
  consumableId      String
  storeLocation     StoreLocation @relation(fields: [storeLocationId], references: [id])
  storeLocationId   String
  batchNumber       String?
  expiryDate        DateTime?
  costPrice         Decimal       @default(0) @db.Decimal(12, 2)
  sellingPrice      Decimal       @default(0) @db.Decimal(12, 2)
  quantityReceived  Int
  quantityRemaining Int
  createdAt         DateTime      @default(now())

  movements   ConsumableMovement[]
  allocations ConsumableStockAllocation[]

  @@index([consumableId, storeLocationId])
}

model ConsumableMovement {
  id              String                @id @default(uuid())
  batch           ConsumableBatch       @relation(fields: [batchId], references: [id])
  batchId         String
  consumable      Consumable            @relation(fields: [consumableId], references: [id])
  consumableId    String
  movementType    InventoryMovementType
  storeLocation   StoreLocation         @relation(fields: [storeLocationId], references: [id])
  storeLocationId String
  quantity        Int
  referenceType   MovementReferenceType
  referenceId     String
  performedBy     Staff                 @relation("ConsumableMovementPerformedBy", fields: [performedById], references: [id])
  performedById   String
  createdAt       DateTime              @default(now())
}

/// Per-batch audit of stock OUT (invoice or usage) and IN (returns), with price snapshots for analytics.
model ConsumableStockAllocation {
  id                   String                        @id @default(uuid())
  batch                ConsumableBatch               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId              String
  direction            ConsumableAllocationDirection
  quantity             Int
  costPriceSnapshot    Decimal                       @db.Decimal(12, 2)
  sellingPriceSnapshot Decimal                       @db.Decimal(12, 2)
  invoiceItem          InvoiceItem?                  @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  invoiceItemId        String?
  usageEvent           ConsumableUsageEvent?         @relation(fields: [usageEventId], references: [id], onDelete: Cascade)
  usageEventId         String?
  performedBy          Staff                         @relation("ConsumableStockAllocationPerformedBy", fields: [performedById], references: [id])
  performedById        String
  createdAt            DateTime                      @default(now())

  @@index([batchId])
  @@index([invoiceItemId])
  @@index([usageEventId])
  @@index([createdAt])
}

/// Non-billable consumable use/return at bedside or during procedures (no invoice line).
model ConsumableUsageEvent {
  id              String                   @id @default(uuid())
  consumable      Consumable               @relation(fields: [consumableId], references: [id])
  consumableId    String
  quantity        Int
  direction       ConsumableUsageDirection
  source          ConsumableUsageSource
  patient         Patient                  @relation(fields: [patientId], references: [id])
  patientId       String
  encounter       Encounter?               @relation(fields: [encounterId], references: [id])
  encounterId     String?
  admission       Admission?               @relation(fields: [admissionId], references: [id])
  admissionId     String?
  storeLocation   StoreLocation            @relation(fields: [storeLocationId], references: [id])
  storeLocationId String
  reversalOf      ConsumableUsageEvent?    @relation("ConsumableUsageReversal", fields: [reversalOfId], references: [id])
  reversalOfId    String?
  reversals       ConsumableUsageEvent[]   @relation("ConsumableUsageReversal")
  performedBy     Staff                    @relation("ConsumableUsageEventPerformedBy", fields: [performedById], references: [id])
  performedById   String
  createdAt       DateTime                 @default(now())

  allocations                ConsumableStockAllocation[]
  dialysisSessionConsumables DialysisSessionConsumable[]
  theatreCaseConsumables     TheatreCaseConsumable[]

  @@index([consumableId, createdAt])
  @@index([patientId, createdAt])
  @@index([encounterId])
  @@index([admissionId])
}

model AuditLog {
  id            String   @id @default(uuid())
  entity        String
  entityId      String
  action        String
  oldValue      Json?
  newValue      Json?
  performedBy   Staff?   @relation("AuditLogPerformedBy", fields: [performedById], references: [id])
  performedById String?
  createdAt     DateTime @default(now())
}

enum CmdCommunicationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum CmdIntegrationHealthStatus {
  healthy
  degraded
  down
}

enum CmdComplianceStatus {
  Compliant
  Pending
  NonCompliant
}

model CmdCommunication {
  id           String                   @id @default(uuid())
  title        String
  body         String
  audience     String
  priority     CmdCommunicationPriority @default(MEDIUM)
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  createdBy    Staff?                   @relation("CmdCommunicationCreatedBy", fields: [createdById], references: [id])
  createdById  String?

  @@index([createdAt])
  @@index([sentAt])
}

model CmdReportTemplate {
  id               String    @id @default(uuid())
  name             String    @unique
  cadence          String
  formatsSupported String[]
  lastGeneratedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        Staff?    @relation("CmdReportTemplateCreatedBy", fields: [createdById], references: [id])
  createdById      String?
}

model CmdIntegrationStatus {
  id          String                     @id @default(uuid())
  name        String                     @unique
  status      CmdIntegrationHealthStatus @default(healthy)
  lastSyncAt  DateTime?
  note        String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  updatedBy   Staff?                     @relation("CmdIntegrationStatusUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
}

model CmdComplianceItem {
  id          String              @id @default(uuid())
  code        String              @unique
  description String
  status      CmdComplianceStatus @default(Pending)
  evidenceUrl String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  updatedBy   Staff?              @relation("CmdComplianceItemUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  @@index([status])
}

// ─── Accounts & Audit (Finance) ───────────────────────────────────────────────

enum FinanceReconciliationStatus {
  open
  submitted
  closed
}

enum FinanceApprovalType {
  REFUND
  WRITE_OFF
  JOURNAL_ADJUSTMENT
  OTHER
}

enum FinanceApprovalStatus {
  pending
  approved
  rejected
}

enum FiscalPeriodStatus {
  open
  closed
}

enum ChartOfAccountType {
  asset
  liability
  equity
  revenue
  expense
}

model FinanceComplianceItem {
  id             String              @id @default(uuid())
  code           String              @unique
  description    String
  status         CmdComplianceStatus @default(Pending)
  lastCheckedAt  DateTime?
  acknowledgedAt DateTime?
  note           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  updatedBy      Staff?              @relation("FinanceComplianceItemUpdatedBy", fields: [updatedById], references: [id])
  updatedById    String?

  @@index([status])
}

model DailyCashReconciliation {
  id            String                      @id @default(uuid())
  date          DateTime                    @unique @db.Date
  countedCash   Decimal?                    @db.Decimal(12, 2)
  expectedCash  Decimal                     @default(0) @db.Decimal(12, 2)
  variance      Decimal                     @default(0) @db.Decimal(12, 2)
  status        FinanceReconciliationStatus @default(open)
  notes         String?
  submittedBy   Staff?                      @relation("DailyCashReconciliationSubmittedBy", fields: [submittedById], references: [id])
  submittedById String?
  closedBy      Staff?                      @relation("DailyCashReconciliationClosedBy", fields: [closedById], references: [id])
  closedById    String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@index([status])
}

model BankReconciliation {
  id                String                      @id @default(uuid())
  bank              Bank                        @relation(fields: [bankId], references: [id])
  bankId            String
  statementDate     DateTime                    @db.Date
  bookBalance       Decimal                     @default(0) @db.Decimal(12, 2)
  statementBalance  Decimal                     @default(0) @db.Decimal(12, 2)
  variance          Decimal                     @default(0) @db.Decimal(12, 2)
  status            FinanceReconciliationStatus @default(open)
  closedBy          Staff?                      @relation("BankReconciliationClosedBy", fields: [closedById], references: [id])
  closedById        String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([bankId, statementDate])
  @@index([status])
}

model FinanceApproval {
  id           String                @id @default(uuid())
  type         FinanceApprovalType
  amount       Decimal               @db.Decimal(12, 2)
  requester    Staff                 @relation("FinanceApprovalRequester", fields: [requesterId], references: [id])
  requesterId  String
  status       FinanceApprovalStatus @default(pending)
  entityRef    String?
  detail       String?
  note         String?
  reason       String?
  reviewedBy   Staff?                @relation("FinanceApprovalReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  submittedAt  DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status])
  @@index([requesterId])
}

model FiscalPeriod {
  id         String             @id @default(uuid())
  label      String
  startDate  DateTime           @db.Date
  endDate    DateTime           @db.Date
  status     FiscalPeriodStatus @default(open)
  closedAt   DateTime?
  closedBy   Staff?             @relation("FiscalPeriodClosedBy", fields: [closedById], references: [id])
  closedById String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  journalEntries JournalEntry[]

  @@index([status])
  @@index([startDate, endDate])
}

model ChartOfAccount {
  id        String             @id @default(uuid())
  code      String             @unique
  name      String
  type      ChartOfAccountType
  isActive  Boolean            @default(true)
  balance   Decimal            @default(0) @db.Decimal(14, 2)
  parent    ChartOfAccount?    @relation("ChartOfAccountHierarchy", fields: [parentId], references: [id])
  parentId  String?
  children  ChartOfAccount[]   @relation("ChartOfAccountHierarchy")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  debitJournalEntries  JournalEntry[] @relation("JournalEntryDebitAccount")
  creditJournalEntries JournalEntry[] @relation("JournalEntryCreditAccount")

  @@index([type])
  @@index([isActive])
}

model JournalEntry {
  id              String          @id @default(uuid())
  entryDate       DateTime        @db.Date
  reference       String          @unique
  description     String
  amount          Decimal         @db.Decimal(12, 2)
  debitAccount    ChartOfAccount  @relation("JournalEntryDebitAccount", fields: [debitAccountId], references: [id])
  debitAccountId  String
  creditAccount   ChartOfAccount  @relation("JournalEntryCreditAccount", fields: [creditAccountId], references: [id])
  creditAccountId String
  fiscalPeriod    FiscalPeriod?   @relation(fields: [fiscalPeriodId], references: [id])
  fiscalPeriodId  String?
  createdBy       Staff           @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  createdById     String
  createdAt       DateTime        @default(now())

  @@index([entryDate])
  @@index([fiscalPeriodId])
}

model ExpenseBudget {
  id           String   @id @default(uuid())
  category     String
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date
  budgetAmount Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([periodStart, periodEnd])
}

model ServiceCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  location    String?

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   Staff   @relation("ServiceCategoryCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("ServiceCategoryUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
}

model Service {
  id           String           @id @default(uuid())
  name         String
  description  String?
  searviceCode String
  cost         Float // or Decimal if you really need precision
  category     ServiceCategory? @relation(fields: [categoryId], references: [id])
  categoryId   String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  departmentId String?

  createdBy   Staff   @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("ServiceUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceItems InvoiceItem[]

  dialysisSessions DialysisSession[]
  surgeryRequests  SurgeryRequest[]
  waitingPatients  WaitingPatient[]
  hmoServicePrices HmoServicePrice[]
  clinicalServicePackageItems ClinicalServicePackageItem[]
}

// ─── Clinical service packages (e.g. default antenatal bundle) ───────────────

model ClinicalServicePackage {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  isActive            Boolean  @default(true)
  isDefaultAntenatal  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  createdBy   Staff   @relation("ClinicalServicePackageCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("ClinicalServicePackageUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  items ClinicalServicePackageItem[]

  @@index([isActive])
  @@index([isDefaultAntenatal])
}

model ClinicalServicePackageItem {
  id        String  @id @default(uuid())
  package   ClinicalServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId String?
  drug      Drug?    @relation(fields: [drugId], references: [id], onDelete: SetNull)
  drugId    String?
  sortOrder Int      @default(0)
  notes     String?

  invoiceItems InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([serviceId])
  @@index([drugId])
}

// ─── HMO (Health Maintenance Organization) ───────────────────────────────────

model Hmo {
  id    String  @id @default(uuid())
  name  String  @unique
  code  String?
  notes String?

  /// Default coverage percent (0-100) used when no per-service override exists in HmoServicePrice.
  defaultCoveragePercent Decimal? @db.Decimal(5, 2)

  patients      Patient[]
  servicePrices HmoServicePrice[]

  invoiceCoverages    InvoiceCoverage[]
  coverageRemittances CoverageRemittance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   Staff   @relation("HmoCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("HmoUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
}

model HmoServicePrice {
  id        String  @id @default(uuid())
  hmo       Hmo     @relation(fields: [hmoId], references: [id], onDelete: Cascade)
  hmoId     String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String

  fullCost    Decimal @db.Decimal(12, 2)
  hmoPays     Decimal @db.Decimal(12, 2)
  patientPays Decimal @db.Decimal(12, 2)

  /// Per-service coverage percent override (0-100); overrides Hmo.defaultCoveragePercent for this service.
  coveragePercent Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hmoId, serviceId])
  @@index([hmoId])
  @@index([serviceId])
}

model Invoice {
  id          String        @id @default(uuid())
  invoiceID   String        @unique
  patient     Patient       @relation(fields: [patientId], references: [id])
  patientId   String
  status      InvoiceStatus @default(PENDING)
  totalAmount Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(12, 2)
  createdBy   Staff         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?        @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  invoiceItems    InvoiceItem[]
  payments        InvoicePayment[]
  refunds              InvoiceRefund[]
  itemRefundRequests   InvoiceItemRefundRequest[]
  walletTxns      WalletTransaction[]
  insuranceClaims InsuranceClaim[]
  auditLogs       InvoiceAuditLog[]
  coverages       InvoiceCoverage[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  staff           Staff               @relation(fields: [staffId], references: [id])
  staffId         String

  encounter        Encounter?          @relation(fields: [encounterId], references: [id])
  encounterId      String?
  consultingRoom   ConsultingRoom?     @relation(fields: [consultingRoomId], references: [id], onDelete: SetNull)
  consultingRoomId String?
