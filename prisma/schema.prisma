// ─── Invoice Coverage / Receivables ──────────────────────────────────────────
//
// InvoiceCoverage rows represent money that a third party (HMO) or a discount
// authority (CMD/CMAC/SUPER_ADMIN) commits to cover on a patient invoice.
// They reduce the invoice's effective payable but never count as cash.
// Approved (non-REVERSED) coverage + cash payments together drive the invoice
// status. SETTLED rows have been remitted by the payer via CoverageRemittance.

enum InvoiceCoverageKind {
  HMO
  DISCOUNT
}

enum InvoiceCoverageMode {
  PERCENT
  FIXED
}

enum InvoiceCoverageScope {
  INVOICE
  ITEM
}

enum InvoiceCoverageStatus {
  APPLIED
  REVERSED
  SETTLED
}

enum DiscountReason {
  CMD
  CMAC
  SUPER_ADMIN
}

enum CoverageRemittancePayerType {
  HMO
  STAFF
}

/// Discount catalog created by CMD / CMAC / SUPER_ADMIN.
/// Billing staff applies one of these to an invoice; the resulting
/// InvoiceCoverage charges to the policy's owner receivables.
model DiscountPolicy {
  id          String              @id @default(uuid())
  name        String
  description String?
  reason      DiscountReason
  mode        InvoiceCoverageMode
  /// Percent (0-100) when mode = PERCENT, or a fixed money amount when mode = FIXED.
  value       Decimal             @db.Decimal(12, 2)
  active      Boolean             @default(true)

  /// Staff to whose receivables every use of this policy is charged.
  owner   Staff  @relation("DiscountPolicyOwner", fields: [ownerId], references: [id])
  ownerId String

  createdBy   Staff   @relation("DiscountPolicyCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("DiscountPolicyUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverages InvoiceCoverage[]

  @@index([reason])
  @@index([ownerId])
  @@index([active])
}

model InvoiceCoverage {
  id            String       @id @default(uuid())
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId String?

  scope InvoiceCoverageScope @default(INVOICE)
  kind  InvoiceCoverageKind

  // For HMO coverage
  hmo   Hmo?    @relation(fields: [hmoId], references: [id])
  hmoId String?

  // For DISCOUNT coverage
  policy   DiscountPolicy? @relation(fields: [policyId], references: [id])
  policyId String?
  reason   DiscountReason?

  /// Staff who owns the receivable (for DISCOUNT). For HMO, hmoId is the payer.
  payer        Staff?  @relation("InvoiceCoveragePayer", fields: [payerStaffId], references: [id])
  payerStaffId String?

  mode   InvoiceCoverageMode
  /// Input value (percent or fixed amount, mirrors mode at apply time).
  value  Decimal             @db.Decimal(12, 2)
  /// Computed money amount actually covered.
  amount Decimal             @db.Decimal(12, 2)

  status InvoiceCoverageStatus @default(APPLIED)
  notes  String?

  appliedBy   Staff  @relation("InvoiceCoverageAppliedBy", fields: [appliedById], references: [id])
  appliedById String

  reversedBy     Staff?    @relation("InvoiceCoverageReversedBy", fields: [reversedById], references: [id])
  reversedById   String?
  reversedAt     DateTime?
  reversalReason String?

  remittance CoverageRemittanceLine?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([invoiceItemId])
  @@index([hmoId, status])
  @@index([payerStaffId, status])
  @@index([policyId])
  @@index([kind, status])
  @@index([reason, status])
}

/// One remittance from a payer (HMO or staff) that settles one or more coverage rows.
model CoverageRemittance {
  id           String                      @id @default(uuid())
  payerType    CoverageRemittancePayerType
  hmo          Hmo?                        @relation(fields: [hmoId], references: [id])
  hmoId        String?
  payerStaff   Staff?                      @relation("CoverageRemittancePayer", fields: [payerStaffId], references: [id])
  payerStaffId String?

  amount    Decimal @db.Decimal(12, 2)
  reference String?
  notes     String?

  receivedBy   Staff?  @relation("CoverageRemittanceReceivedBy", fields: [receivedById], references: [id])
  receivedById String?

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  lines CoverageRemittanceLine[]

  @@index([payerType])
  @@index([hmoId])
  @@index([payerStaffId])
  @@index([paidAt])
}

model CoverageRemittanceLine {
  id           String             @id @default(uuid())
  remittance   CoverageRemittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  remittanceId String
  coverage     InvoiceCoverage    @relation(fields: [coverageId], references: [id])
  coverageId   String             @unique
  amount       Decimal            @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([remittanceId])
}

