model OutpatientNurseAssignment {
  id           String       @id @default(uuid())
  nurse        Staff        @relation("OutpatientNurseAssignmentNurse", fields: [nurseId], references: [id])
  nurseId      String
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  invoiceId    String
  nursingUnit  NursingUnit
