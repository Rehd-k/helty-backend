  primaryIcdCode         String?
  primaryIcdDescription  String?
  secondaryDiagnosesJson String?
  proceduresJson         String?
  specialtyModulesJson   String?
  clinicalSectionsJson   String?
  followUpDate           String?
  followUpInstructions   String?
  referral               String?

  doctor      Staff  @relation("EncounterTemplateDoctor", fields: [doctorId], references: [id])
  doctorId    String
  createdBy   Staff  @relation("EncounterTemplateCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff? @relation("EncounterTemplateUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, name])
  @@index([doctorId])
}

/// Per-encounter specialty configuration: which clinical sections the clinician enabled for a given specialty.
model EncounterSpecialtyModule {
  id                 String           @id @default(uuid())
  encounter          Encounter        @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  encounterId        String
  specialty          MedicalSpecialty
  enabledSectionKeys Json // string[] of section keys, e.g. ["cardiology.ecg","cardiology.echo"]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdBy          Staff            @relation("EncounterSpecialtyModuleCreatedBy", fields: [createdById], references: [id])
  createdById        String
  updatedBy          Staff?           @relation("EncounterSpecialtyModuleUpdatedBy", fields: [updatedById], references: [id])
  updatedById        String?

  @@unique([encounterId, specialty])
  @@index([encounterId])
}

/// Versioned JSON payload for one enabled section within a specialty on an encounter.
model EncounterClinicalSection {
  id            String           @id @default(uuid())
  encounter     Encounter        @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  encounterId   String
  specialty     MedicalSpecialty
  sectionKey    String
  schemaVersion Int              @default(1)
  data          Json
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     Staff            @relation("EncounterClinicalSectionCreatedBy", fields: [createdById], references: [id])
  createdById   String
  updatedBy     Staff?           @relation("EncounterClinicalSectionUpdatedBy", fields: [updatedById], references: [id])
  updatedById   String?

  @@unique([encounterId, specialty, sectionKey])
  @@index([encounterId])
  @@index([specialty, sectionKey])
}

// Structured diagnosis per encounter
model EncounterDiagnosis {
  id                     String    @id @default(uuid())
  encounter              Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  encounterId            String
  primaryIcdCode         String?
  primaryIcdDescription  String?
  secondaryDiagnosesJson Json? // JSON array of { code, description }
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// Lab order/request tied to an encounter (before results in LabReport)
model LabRequest {
  id                  String           @id @default(uuid())
  encounter           Encounter        @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  encounterId         String
  patient             Patient          @relation(fields: [patientId], references: [id])
  patientId           String
  admission           Admission?       @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  admissionId         String?
  ward                Ward?            @relation("LabRequestWard", fields: [wardId], references: [id], onDelete: SetNull)
  wardId              String?
  requestedBy         Staff            @relation("LabRequestOrderedBy", fields: [requestedByDoctorId], references: [id])
  requestedByDoctorId String
  testType            String?
  notes               String?
  status              LabRequestStatus @default(REQUESTED)
  invoice             Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId           String?
  invoiceItem         InvoiceItem?     @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId       String?          @unique
  pregnancy           Pregnancy?       @relation(fields: [pregnancyId], references: [id], onDelete: SetNull)
  pregnancyId         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([invoiceId])
  @@index([pregnancyId])
  @@index([admissionId])
  @@index([wardId])
}

// InsuranceClaim: insurance coverage applied to an invoice
model InsuranceClaim {
  id            String   @id @default(uuid())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  provider      String
  policyNumber  String?
  coveredAmount Decimal  @db.Decimal(12, 2)
  status        String   @default("PENDING")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy   Staff?  @relation("InsuranceClaimCreatedBy", fields: [createdById], references: [id])
  createdById String?
  updatedBy   Staff?  @relation("InsuranceClaimUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  @@index([invoiceId])
}

// Bank: hospital bank accounts that can receive payments
model Bank {
  id            String @id @default(uuid())
  name          String
  accountNumber String @unique

  invoicePayments     InvoicePayment[]
  bankReconciliations BankReconciliation[]

  createdBy   Staff?  @relation("BankCreatedBy", fields: [createdById], references: [id])
  createdById String?
  updatedBy   Staff?  @relation("BankUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
  staff     Staff?    @relation(fields: [staffId], references: [id])
  staffId   String?
}

model PatientVitals {
  id String @id @default(uuid())

  systolic     Int?
  diastolic    Int?
  temperature  Float?
  height       Float?
  weight       Float?
  bmi          Float?
  pulseRate    Int?
  respRate     Int?
  spo2         Float?
  painScore    Int?
  notes        String?
  bloodGlucose Float?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  waitingPatient    WaitingPatient? @relation(fields: [waitingPatientId], references: [id])
  waitingPatientId  String?         @unique
  admission         Admission?      @relation(fields: [admissionId], references: [id])
  admissionId       String?
  encounter         Encounter?      @relation(fields: [encounterId], references: [id])
  encounterId       String?
  patient           Patient?        @relation(fields: [patientId], references: [id])
  patientId         String?
  nurse             Staff?          @relation("PatientVitalsRecordedByNurse", fields: [recordedByNurseId], references: [id])
  recordedByNurseId String?
  createdBy         Staff?          @relation("PatientVitalsCreatedBy", fields: [createdById], references: [id])
  createdById       String?
  invoice           Invoice?        @relation("InvoiceVitals")

  shiftType  ShiftType?
  recordedAt DateTime   @default(now())

  @@index([encounterId])
}

model ConsultingRoom {
  id          String   @id @default(uuid())
  name        String
  description String?
  location    String?
  capacity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy       Staff?           @relation("ConsultingRoomCreatedBy", fields: [createdById], references: [id])
  createdById     String?
  updatedBy       Staff?           @relation("ConsultingRoomUpdatedBy", fields: [updatedById], references: [id])
  updatedById     String?
  staff           Staff?           @relation(fields: [staffId], references: [id])
  staffId         String?
  waitingPatients WaitingPatient[]
  invoices        Invoice[]
}

model WaitingPatient {
  id               String          @id @default(uuid())
  patient          Patient         @relation(fields: [patientId], references: [id])
  patientId        String
  consultingRoom   ConsultingRoom? @relation(fields: [consultingRoomId], references: [id])
  consultingRoomId String?
  vitals           PatientVitals?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  service          Service?        @relation(fields: [serviceId], references: [id])
  serviceId        String?
  seen             Boolean         @default(false)

  createdBy   Staff?  @relation("WaitingPatientCreatedBy", fields: [createdById], references: [id])
  createdById String?
  updatedBy   Staff?  @relation("WaitingPatientUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
  staff       Staff?  @relation(fields: [staffId], references: [id])
  staffId     String?
}

model PatientAllergy {
  id        String  @id @default(uuid())
  patient   Patient @relation(fields: [patientId], references: [id])
  patientId String

  allergen String
  reaction String?
  severity String?
  type     String?
  notes    String?

  createdAt DateTime @default(now())
}

model Ward {
  id           String      @id @default(uuid())
  name         String
  capacity     Int
  type         WardType
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  drugPricePercentage    Decimal? @default(1.0) @db.Decimal(12, 2)
  servicePricePercentage Decimal? @default(1.0) @db.Decimal(12, 2)

  beds                 Bed[]
  admissions           Admission[]        @relation("WardAdmissions")
  nurseShiftRosters    NurseShiftRoster[]
  assignedChargeNurses Staff[]
  wardHistoryFrom      AdmissionWardHistory[] @relation("AdmissionWardHistoryFrom")
  wardHistoryTo        AdmissionWardHistory[] @relation("AdmissionWardHistoryTo")
  labRequests          LabRequest[]           @relation("LabRequestWard")
  labOrders            LabOrder[]             @relation("LabOrderWard")
  radiologyOrders      RadiologyOrder[]       @relation("RadiologyOrderWard")
  prescriptions        Prescription[]         @relation("PrescriptionRequestWard")
  medicationRequests   MedicationRequest[]    @relation("MedicationRequestWard")
  surgeryRequests      SurgeryRequest[]       @relation("SurgeryRequestWard")

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  drugPrices DrugPrice[]
  patients   Patient[]
}

model Bed {
  id        String    @id @default(uuid())
  ward      Ward      @relation(fields: [wardId], references: [id])
  wardId    String
  bedNumber String
  status    BedStatus @default(AVAILABLE)

  admissions Admission[] @relation("BedAdmissions")
  wardHistoryFrom AdmissionWardHistory[] @relation("AdmissionWardHistoryFromBed")
  wardHistoryTo   AdmissionWardHistory[] @relation("AdmissionWardHistoryToBed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Orders (from encounter tabs) ──────────────────────────────────────────────

model DrugCatalog {
  id                String    @id @default(uuid())
  name              String
  generic           String?
  strength          String?
  form              String?
  stockStatus       String?
  contraindications String?
  interactions      String?
  createdAt         DateTime? @default(now())
  updatedAt         DateTime? @updatedAt

  medicationOrders MedicationOrder[]

  @@index([name])
}

model MedicationOrder {
  id                   String                                  @id @default(uuid())
  encounterId          String
  admissionId          String?
  drugId               String?
  drugName             String // denormalized for display
  dose                 String?
  /// Ordered amount per administration (e.g. 2 tablets). Compared when nurses record administrations.
  quantity             Decimal?                                @db.Decimal(12, 3)
  frequency            String?
  duration             String?
  route                String?
  specialInstructions  String?
  startDateTime        DateTime?
  endDateTime          DateTime?
  notes                String?
  administrationStatus MedicationAdministrationLifecycleStatus @default(ACTIVE)
  patientId            String
  patient              Patient                                 @relation(fields: [patientId], references: [id])
  doctorId             String
  doctor               Staff                                   @relation(fields: [doctorId], references: [id])
  /// Snapshot of the catalog drug at prescribe time (unchanged when pharmacy substitutes).
  prescribedDrugId     String?
  prescribedDrug       Drug?                                   @relation("MedicationOrderPrescribedDrug", fields: [prescribedDrugId], references: [id], onDelete: SetNull)
  prescribedDrugName   String?
  substitutedByPharmacistId String?
  substitutedByPharmacist   Staff?                              @relation("MedicationOrderSubstitutedBy", fields: [substitutedByPharmacistId], references: [id], onDelete: SetNull)
  substitutedAt        DateTime?
  status               String                                  @default("Prescribed") // Prescribed, Pending Dispense, Dispensed, Cancelled
  createdAt            DateTime?                               @default(now())
  updatedAt            DateTime?                               @updatedAt

  encounter         Encounter                  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  admission         Admission?                 @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  drug              Drug?                      @relation("MedicationOrderCurrentDrug", fields: [drugId], references: [id], onDelete: Restrict)
  drugCatalog       DrugCatalog?               @relation(fields: [drugCatalogId], references: [id])
  drugCatalogId     String?
  invoiceItem       InvoiceItem?               @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId     String?                    @unique
  administrations   MedicationAdministration[]
  medicationRequests MedicationRequest[]
  doseSchedule      MedicationOrderSchedule?
  alertLogs         AlertLog[]
  pregnancy         Pregnancy?                 @relation(fields: [pregnancyId], references: [id], onDelete: SetNull)
  pregnancyId       String?

  @@index([encounterId])
  @@index([admissionId])
  @@index([patientId])
  @@index([invoiceItemId])
  @@index([prescribedDrugId])
  @@index([substitutedByPharmacistId])
  @@index([pregnancyId])
}

model MedicationOrderSchedule {
  id                        String                   @id @default(uuid())
  medicationOrderId         String                   @unique
  medicationOrder           MedicationOrder          @relation(fields: [medicationOrderId], references: [id], onDelete: Cascade)

  scheduleStartedAt         DateTime?
  courseEndsAt              DateTime?
  nextDueAt                 DateTime?
  lastAdministeredAt        DateTime?
  doseSequenceNumber        Int                      @default(0)

  scheduleStatus            MedicationScheduleStatus @default(NOT_STARTED)

  dosesPerDay               Decimal?                 @db.Decimal(12, 6)
  frequencyIntervalHours    Decimal?                 @db.Decimal(12, 6)

  durationValue             Int?
  durationUnit              RxDurationUnit?

  beyondDurationConsentAt   DateTime?
  beyondDurationConsentById String?
  beyondDurationConsentBy   Staff?                   @relation("MedicationBeyondDurationConsent", fields: [beyondDurationConsentById], references: [id])
  beyondDurationConsentNote String?

  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([scheduleStatus])
  @@index([nextDueAt])
  @@index([courseEndsAt])
}

model MedicationRequest {
  id                 String                  @id @default(uuid())
  medicationOrderId  String
  medicationOrder    MedicationOrder         @relation(fields: [medicationOrderId], references: [id], onDelete: Cascade)
  encounterId        String
  encounter          Encounter               @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient                 @relation(fields: [patientId], references: [id])
  admission          Admission?              @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  admissionId        String?
  ward               Ward?                   @relation("MedicationRequestWard", fields: [wardId], references: [id], onDelete: SetNull)
  wardId             String?
  requestedQuantity  Int
  requestedByNurseId String
  requestedByNurse   Staff                   @relation("MedicationRequestRequestedBy", fields: [requestedByNurseId], references: [id])
  status             MedicationRequestStatus @default(REQUESTED)
  invoiceItemId      String?                 @unique
  invoiceItem        InvoiceItem?            @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  billedById         String?
  billedBy           Staff?                  @relation("MedicationRequestBilledBy", fields: [billedById], references: [id])
  billedAt           DateTime?
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([medicationOrderId])
  @@index([encounterId])
  @@index([patientId])
  @@index([status])
  @@index([invoiceItemId])
  @@index([admissionId])
  @@index([wardId])
}

model LegacyLabCatalog {
  id          String    @id @default(uuid())
  name        String
  department  String?
  cost        Float?
  turnaround  String?
  sampleType  String?
  preparation String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  labOrders LegacyLabOrder[]

  @@index([name])
}

model LegacyLabOrder {
  id            String    @id @default(uuid())
  encounterId   String
  catalogTestId String
  testName      String
  priority      String?   @default("Routine") // Routine, Urgent, STAT
  clinicalNotes String?
  status        String    @default("Ordered") // Ordered, SampleReceived, InProgress, Completed, Cancelled
  resultValues  Json? // { "Hb": "12.5", "WBC": "7.2", ... }
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt

  encounter Encounter        @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  catalog   LegacyLabCatalog @relation(fields: [catalogTestId], references: [id], onDelete: Restrict)

  @@index([encounterId])
}

// ─── CMAC Quality & Safety ───────────────────────────────────────────────────

enum ReferralDirection {
  IN
  OUT
}

enum ReferralStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum PatientFeedbackKind {
  COMPLAINT
  SUGGESTION
  GENERAL
}

enum PatientFeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum EmergencyRequestStatus {
  SUBMITTED
  ACKNOWLEDGED
  DISPATCHED
  CLOSED
  CANCELLED
}

enum SafetyIncidentType {
  MEDICATION
  FALL
  PROCEDURE
  DOCUMENTATION
  OTHER
}

enum SafetyIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SafetyIncidentStatus {
  OPEN
  INVESTIGATING
  CLOSED
}

enum InfectionCaseType {
  HAI
  SURGICAL_SITE
  WOUND
  OTHER
}

enum InfectionCaseStatus {
  ACTIVE
  RESOLVED
}

enum LabAbnormalFlag {
  LOW
  HIGH
}

model Referral {
  id                String            @id @default(uuid())
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId         String
  direction         ReferralDirection
  status            ReferralStatus    @default(PENDING)
  referringFacility String?
  receivingFacility String?
  reason            String?
  occurredAt        DateTime          @default(now())
  encounter         Encounter?        @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  encounterId       String?
  admission         Admission?        @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  admissionId       String?
  department        Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId      String?
  createdBy         Staff             @relation("ReferralCreatedBy", fields: [createdById], references: [id])
  createdById       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([patientId])
  @@index([direction, occurredAt])
  @@index([departmentId])
}

model PatientComplaint {
  id           String            @id @default(uuid())
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId    String
  category     String
  description  String
  severity     ComplaintSeverity @default(MEDIUM)
  status       ComplaintStatus   @default(OPEN)
  reportedAt   DateTime          @default(now())
  resolvedAt   DateTime?
  encounter    Encounter?        @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  encounterId  String?
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId String?
  assignedTo   Staff?            @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?
  createdBy    Staff             @relation("ComplaintCreatedBy", fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([patientId])
  @@index([status, reportedAt])
  @@index([departmentId])
}

model PatientFeedback {
  id            String                @id @default(uuid())
  patient       Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId     String
  kind          PatientFeedbackKind
  subject       String
  message       String
  status        PatientFeedbackStatus @default(OPEN)
  department    Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId  String?
  staffResponse String?
  resolvedAt    DateTime?
  respondedBy   Staff?                @relation("PatientFeedbackRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedById String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([patientId])
  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([departmentId])
}

model EmergencyRequest {
  id              String                  @id @default(uuid())
  patient         Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId       String
  status          EmergencyRequestStatus  @default(SUBMITTED)
  latitude        Float
  longitude       Float
  accuracyMeters  Float?
  addressText     String?
  description     String?
  voiceUrl        String?
  videoUrl        String?
  staffNote       String?
  respondedBy     Staff?                  @relation("EmergencyRequestRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedById   String?
  acknowledgedAt  DateTime?
  dispatchedAt    DateTime?
  closedAt        DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([patientId])
  @@index([status, createdAt])
}

model SafetyIncident {
  id               String                 @id @default(uuid())
  patient          Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId        String
  type             SafetyIncidentType
  severity         SafetyIncidentSeverity @default(MEDIUM)
  status           SafetyIncidentStatus   @default(OPEN)
  description      String
  rootCause        String?
  correctiveAction String?
  occurredAt       DateTime               @default(now())
  encounter        Encounter?             @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  encounterId      String?
  admission        Admission?             @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  admissionId      String?
  department       Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId     String?
  reportedBy       Staff                  @relation("SafetyIncidentReportedBy", fields: [reportedById], references: [id])
  reportedById     String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([patientId])
  @@index([type, severity])
  @@index([status, occurredAt])
  @@index([departmentId])
}

model InfectionCase {
  id           String              @id @default(uuid())
  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId    String
  admission    Admission           @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  admissionId  String
  type         InfectionCaseType
  status       InfectionCaseStatus @default(ACTIVE)
  organism     String?
  site         String?
  isolated     Boolean             @default(false)
  onsetDate    DateTime
  resolvedAt   DateTime?
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId String?
  createdBy    Staff               @relation("InfectionCaseCreatedBy", fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([patientId])
  @@index([admissionId])
  @@index([status, onsetDate])
  @@index([departmentId])
}

// ─── Dynamic Lab Module (build-once-use-everywhere) ─────────────────────────

enum LabOrderStatus {
  PENDING
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  VERIFIED
}

enum DialysisSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LabTestFieldType {
  TEXT
  NUMBER
  DROPDOWN
  CHECKBOX
  MULTISELECT
  DATE
}

model LabCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  tests LabTest[]

  @@index([name])
}

model LabTest {
  id          String   @id @default(uuid())
  name        String
  categoryId  String
  sampleType  String // blood, urine, stool, sputum, swab, etc.
  description String?
  price       Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  category LabCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  versions LabTestVersion[]

  @@index([categoryId])
  @@index([isActive])
}

model LabTestVersion {
  id            String   @id @default(uuid())
  testId        String
  versionNumber Int
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())

  test       LabTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  fields     LabTestField[]
  orderItems LabOrderItem[]

  @@unique([testId, versionNumber])
  @@index([testId])
  @@index([isActive])
}

model LabTestField {
  id             String           @id @default(uuid())
  testVersionId  String
  label          String
  fieldType      LabTestFieldType
  unit           String?
  referenceRange String?
  required       Boolean          @default(false)
  position       Int              @default(0)
  optionsJson    String? // JSON for DROPDOWN/MULTISELECT options
  createdAt      DateTime         @default(now())

  testVersion LabTestVersion @relation(fields: [testVersionId], references: [id], onDelete: Cascade)
  results     LabResult[]

  @@index([testVersionId])
}

model LabOrder {
  id                String         @id @default(uuid())
  patientId         String
  doctorId          String
  status            LabOrderStatus @default(PENDING)
  admission         Admission?     @relation(fields: [admissionId], references: [id], onDelete: SetNull)
