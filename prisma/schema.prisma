  assignedById String
  assignedAt   DateTime     @default(now())
  shiftDate    DateTime?
  shiftType    ShiftType?

  @@unique([invoiceId])
  @@index([nurseId])
  @@index([nursingUnit, assignedAt])
}

model MedicationAdministration {
  id                    String          @id @default(uuid())
  medicationOrder       MedicationOrder @relation(fields: [medicationOrderId], references: [id])
  medicationOrderId     String
  admission             Admission       @relation(fields: [admissionId], references: [id])
  admissionId           String
  nurse                 Staff           @relation("MedicationAdministrationNurse", fields: [administeredByNurseId], references: [id])
  administeredByNurseId String

  scheduledTime    DateTime
  actualTime       DateTime?
  status           MedicationAdminStatus
  /// Amount actually administered (when status is GIVEN).
  quantity         Decimal?              @db.Decimal(12, 3)
  /// True when quantity exceeds the ordered amount on the linked medication order.
  isOverMedication Boolean               @default(false)
  reasonIfNotGiven String?
  remarks          String?
  doseNumber       Int?
  isFirstDose      Boolean               @default(false)
  /// Dispensary stock was deducted from (when nurse selected one at administration).
  pharmacyLocationId    String?
  /// Whole units removed from inventory; null when no dispensary was used.
  stockDeductedQuantity Int?

  pharmacyLocation PharmacyLocation? @relation(fields: [pharmacyLocationId], references: [id])
  invoiceItem        InvoiceItem?      @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId      String?           @unique

  createdAt DateTime @default(now())

  @@index([pharmacyLocationId])
  @@index([invoiceItemId])
}

model IVFluidOrder {
