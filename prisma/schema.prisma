/// One-time 6-digit codes for staff password reset (plain `code` in DB for admin handoff until SMTP).
model StaffPasswordReset {
  id        String    @id @default(uuid())
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId])
}

enum ChatMessageStatus {
  SENT
  DELIVERED
  READ
}

model ChatMessage {
  id          String            @id @default(uuid())
  sender      Staff             @relation("ChatMessageSender", fields: [senderId], references: [id])
  senderId    String
  recipient   Staff             @relation("ChatMessageRecipient", fields: [recipientId], references: [id])
  recipientId String
  content     String
  status      ChatMessageStatus @default(SENT)
  createdAt   DateTime          @default(now())
}

// --- Internal staff chat & support tickets (Slack-like; Staff.id is the user id) ---

enum StaffConversationType {
  DIRECT
  GROUP
}

enum StaffConversationMemberRole {
  ADMIN
  MEMBER
}

enum StaffConversationMessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SupportTicketAuditAction {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
  MESSAGE_ADDED
  TITLE_CHANGED
}

model StaffConversation {
  id        String                @id @default(uuid())
  type      StaffConversationType
  name      String?
  directKey String?               @unique
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  members  StaffConversationMember[]
  messages StaffConversationMessage[]

  @@index([type])
}

model StaffConversationMember {
  id             String                      @id @default(uuid())
  conversation   StaffConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  staff          Staff                       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId        String
  role           StaffConversationMemberRole @default(MEMBER)
  createdAt      DateTime                    @default(now())

  @@unique([conversationId, staffId])
  @@index([staffId])
}

model StaffConversationMessage {
  id             String                       @id @default(uuid())
  conversation   StaffConversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         Staff                        @relation("StaffConversationMessageSender", fields: [senderId], references: [id])
  senderId       String
  content        String?
  type           StaffConversationMessageType @default(TEXT)
  fileUrl        String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  reads StaffConversationMessageRead[]

  @@index([conversationId, createdAt(sort: Desc), id])
}

model StaffConversationMessageRead {
  id        String                   @id @default(uuid())
  message   StaffConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  staff     Staff                    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  readAt    DateTime                 @default(now())

  @@unique([messageId, staffId])
  @@index([staffId])
}

model SupportTicket {
  id          String              @id @default(uuid())
  title       String
  createdBy   Staff               @relation("SupportTicketCreatedBy", fields: [createdById], references: [id])
  createdById String
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  assignments SupportTicketAssignment[]
  messages    SupportTicketMessage[]
  auditLogs   SupportTicketAuditLog[]

  @@index([status])
  @@index([createdById])
}

model SupportTicketAssignment {
  id           String        @id @default(uuid())
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId     String
  staff        Staff         @relation("SupportTicketAssignmentAssignee", fields: [staffId], references: [id], onDelete: Cascade)
  staffId      String
  assignedBy   Staff         @relation("SupportTicketAssignmentBy", fields: [assignedById], references: [id])
  assignedById String
  assignedAt   DateTime      @default(now())

  @@unique([ticketId, staffId])
  @@index([staffId])
}

model SupportTicketMessage {
  id        String        @id @default(uuid())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  sender    Staff         @relation(fields: [senderId], references: [id])
  senderId  String
  content   String?
  fileUrl   String?
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model SupportTicketAuditLog {
  id        String                   @id @default(uuid())
  ticket    SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  action    SupportTicketAuditAction
  actor     Staff                    @relation(fields: [actorId], references: [id])
  actorId   String
  payload   Json?
  createdAt DateTime                 @default(now())

  @@index([ticketId, createdAt])
}

// Encounter: clinical anchor for every doctor interaction (outpatient, emergency, inpatient review, etc.)
// Merged with OPD/visit fields and orders (medication, lab, imaging).
model Encounter {
  id             String          @id @default(uuid())
  patient        Patient         @relation(fields: [patientId], references: [id])
  patientId      String
  doctor         Staff           @relation("EncounterDoctor", fields: [doctorId], references: [id])
  doctorId       String
  admission      Admission?      @relation("AdmissionEncounter", fields: [admissionId], references: [id])
  admissionId    String?         @unique
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId  String?
  encounterType  EncounterType
  startTime      DateTime
  endTime        DateTime?
  chiefComplaint String?
  triageNotes    String?
  status         EncounterStatus @default(ONGOING)

  // OPD / visit context
  visitType              String? // OPD, Walk-in, Follow-up
  insurance              String?
  // History
  hpi                    String?
  pmh                    String?
  surgicalHistory        String?
  drugHistory            String?
  allergyHistory         String?
  familyHistory          String?
  socialHistory          String?
  // Examination & SOAP
  examinationNotes       String?
  soapSubjective         String?
  soapObjective          String?
  soapAssessment         String?
  soapPlan               String?
  soapLockedAt           DateTime?
  // Diagnosis (structured use EncounterDiagnosis; these for quick/legacy)
  primaryIcdCode         String?
  primaryIcdDescription  String?
  secondaryDiagnosesJson String? // JSON array of { code, description }
  proceduresJson         String? // JSON array of { id?, type, consent?, notes?, complications?, serviceId?, invoiceId?, invoiceItemId?, consumables?: [{ id?, consumableId, quantity?, storeLocationId, invoiceItemId? }] }
  // Follow-up
  followUpDate           String?
  followUpInstructions   String?
  referral               String?

  doctorReports    DoctorReport[]
  prescriptions    Prescription[]
  labReports       LabReport[]
  radiologyReports RadiologyReport[]
  diagnoses        EncounterDiagnosis[]
  labRequests      LabRequest[]
  medicationOrders   MedicationOrder[]
  medicationRequests MedicationRequest[]
  legacyLabOrders    LegacyLabOrder[]
  radiologyOrders  RadiologyOrder[]
  antenatalVisits  AntenatalVisit[]
  gynaeProcedures  GynaeProcedure[]
  surgeryRequests  SurgeryRequest[]

  specialtyModules      EncounterSpecialtyModule[]
  clinicalSections      EncounterClinicalSection[]
  consumableUsageEvents ConsumableUsageEvent[]
  referrals             Referral[]
  complaints            PatientComplaint[]
  safetyIncidents       SafetyIncident[]

  createdBy   Staff     @relation("EncounterCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?    @relation("EncounterUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices      Invoice[]
  editHistory   EncounterEditHistory[]
  patientVitals PatientVitals[]
  pregnancy     Pregnancy?
}

/// Snapshot of full clinical state immediately before a post-completion edit.
model EncounterEditHistory {
  id          String    @id @default(uuid())
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  encounterId String
  editedBy    Staff     @relation("EncounterEditHistoryEditedBy", fields: [editedById], references: [id])
  editedById  String
  editedAt    DateTime  @default(now())
  reason      String?
  snapshot    Json
  changedKeys String[]

  @@index([encounterId, editedAt])
}

