  ward              Ward?          @relation("LabOrderWard", fields: [wardId], references: [id], onDelete: SetNull)
  wardId            String?
  invoiceItem       InvoiceItem?   @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId     String?        @unique
  sampleCollectedAt DateTime?
  completedAt       DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime       @default(now())

  patient Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor  Staff          @relation("LabOrderDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  items   LabOrderItem[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([invoiceItemId])
  @@index([completedAt])
  @@index([admissionId])
  @@index([wardId])
}

model DialysisSession {
  id            String                @id @default(uuid())
  patientId     String
  status        DialysisSessionStatus @default(PENDING)
  invoice       Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
