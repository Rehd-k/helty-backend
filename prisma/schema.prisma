}

// ─────────────────────────────────────────────────────────────────────────────
// OBSTETRICS & GYNAECOLOGY MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Pregnancy {
  id          String          @id @default(uuid())
  patient     Patient         @relation(fields: [patientId], references: [id])
  patientId   String
  gravida     Int
  para        Int
  lmp         DateTime
  edd         DateTime
  bookingDate DateTime?
  status      PregnancyStatus @default(ONGOING)
  outcome     String?

  respiratoryRate   Int?
  heartRate         Int?
  systolicBP        Int?
  diastolicBP       Int?
  spo2              Float?
  genotype          String?
  bloodGroup        String?
  pcv               Float?
  hcv               String?
  hbsAg             String?
  vdrl              String?
  hiv12             String?
  urinalysisProtein String?
  urinalysisGlucose String?
  ttImmunization    String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy   Staff   @relation("PregnancyCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("PregnancyUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  encounterId String?    @unique

  antenatalVisits  AntenatalVisit[]
  labourDeliveries LabourDelivery[] @relation("PregnancyLabourDeliveries")
  labRequests      LabRequest[]
  medicationOrders MedicationOrder[]
  radiologyOrders  RadiologyOrder[]

  @@index([patientId])
  @@index([status])
  @@index([encounterId])
}

model AntenatalVisit {
  id                 String             @id @default(uuid())
  pregnancy          Pregnancy          @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  pregnancyId        String
  visitDate          DateTime
  gestationWeeks     Float?
  gestationDays      Int?
  systolicBP         Int?
  diastolicBP        Int?
  weight             Float?
  fundalHeight       Float?
  fetalHeartRate     Int?
  presentation       FetalPresentation?
  descent            String?
  urineProtein       String?
  urineGlucose       String?
  pcv                Float?
  notes              String?
  ultrasoundFindings String?
  labResultsJson     Json?
  staff              Staff              @relation(fields: [staffId], references: [id])
  staffId            String
  encounter          Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  encounterId        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([pregnancyId])
  @@index([visitDate])
}

model LabourDelivery {
  id                String          @id @default(uuid())
  pregnancy         Pregnancy       @relation("PregnancyLabourDeliveries", fields: [pregnancyId], references: [id], onDelete: Cascade)
  pregnancyId       String
  admission         Admission?      @relation("AdmissionLabourDeliveries", fields: [admissionId], references: [id], onDelete: SetNull)
  admissionId       String?
  deliveryDateTime  DateTime
  mode              DeliveryMode
  outcome           DeliveryOutcome
  bloodLossMl       Int?
  placentaComplete  Boolean?
  episiotomy        Boolean?
  perinealTearGrade String?
  notes             String?
  deliveredBy       Staff           @relation(fields: [deliveredById], references: [id])
  deliveredById     String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  partogramEntries PartogramEntry[]
  babies           Baby[]
  postnatalVisits  PostnatalVisit[]

  @@index([pregnancyId])
  @@index([admissionId])
}

model PartogramEntry {
  id                   String         @id @default(uuid())
  labourDelivery       LabourDelivery @relation(fields: [labourDeliveryId], references: [id], onDelete: Cascade)
  labourDeliveryId     String
  recordedAt           DateTime
  cervicalDilationCm   Float?
  station              Int?
  contractionsPer10Min Int?
  fetalHeartRate       Int?
  moulding             String?
  descent              String?
  oxytocin             String?
  comments             String?
  recordedBy           Staff          @relation(fields: [recordedById], references: [id])
  recordedById         String
  createdAt            DateTime       @default(now())

  @@index([labourDeliveryId])
  @@index([recordedAt])
}

model Baby {
  id                  String         @id @default(uuid())
  labourDelivery      LabourDelivery @relation(fields: [labourDeliveryId], references: [id], onDelete: Cascade)
  labourDeliveryId    String
  mother              Patient        @relation(fields: [motherId], references: [id])
  motherId            String
  sex                 BabySex
  birthWeightG        Int?
  birthLengthCm       Float?
  apgar1              Int?
  apgar5              Int?
  resuscitation       String?
  birthOrder          Int            @default(1)
  registeredPatient   Patient?       @relation("BabyRegisteredPatient", fields: [registeredPatientId], references: [id], onDelete: SetNull)
  registeredPatientId String?        @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  createdBy   Staff   @relation("BabyCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   Staff?  @relation("BabyUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  postnatalVisits PostnatalVisit[]

  @@index([labourDeliveryId])
  @@index([motherId])
}

model PostnatalVisit {
  id                String             @id @default(uuid())
  labourDelivery    LabourDelivery     @relation(fields: [labourDeliveryId], references: [id], onDelete: Cascade)
  labourDeliveryId  String
  type              PostnatalVisitType
  visitDate         DateTime
  patient           Patient?           @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientId         String?
  baby              Baby?              @relation(fields: [babyId], references: [id], onDelete: SetNull)
  babyId            String?
  uterusInvolution  String?
  lochia            String?
  perineum          String?
  bloodPressure     String?
  temperature       Float?
  breastfeeding     String?
  weight            Float?
  feeding           String?
  jaundice          String?
  immunisationGiven String?
  notes             String?
  staff             Staff              @relation(fields: [staffId], references: [id])
  staffId           String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([labourDeliveryId])
  @@index([type])
  @@index([visitDate])
}

model GynaeProcedure {
  id            String     @id @default(uuid())
  patient       Patient    @relation(fields: [patientId], references: [id])
  patientId     String
  encounter     Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  encounterId   String?
  admission     Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  admissionId   String?
  procedureType String
  procedureDate DateTime
  surgeon       Staff      @relation("GynaeProcedureSurgeon", fields: [surgeonId], references: [id])
  surgeonId     String
  assistant     Staff?     @relation("GynaeProcedureAssistant", fields: [assistantId], references: [id], onDelete: SetNull)
  assistantId   String?
  findings      String?
  complications String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([patientId])
  @@index([procedureDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// THEATRE MODULE
// ─────────────────────────────────────────────────────────────────────────────

enum SurgeryRequestStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  BILLED
  CANCELLED
}

enum SurgeryPriority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum TheatreCaseStaffRole {
  SURGEON
  ASSISTANT
  SCRUB
  CIRCULATING
  ANAESTHETIST
}

model TheatreRoom {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules TheatreSchedule[]

  @@index([isActive])
}

model SurgeryRequest {
  id            String               @id @default(uuid())
  patient       Patient              @relation(fields: [patientId], references: [id])
  patientId     String
  encounter     Encounter            @relation(fields: [encounterId], references: [id])
  encounterId   String
  admission     Admission?           @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  admissionId   String?
  ward          Ward?                @relation("SurgeryRequestWard", fields: [wardId], references: [id], onDelete: SetNull)
  wardId        String?
  requestedBy   Staff                @relation("SurgeryRequestRequestedBy", fields: [requestedById], references: [id])
  requestedById String
  service       Service              @relation(fields: [serviceId], references: [id])
  serviceId     String
  priority      SurgeryPriority      @default(ROUTINE)
  clinicalNotes String?
  preferredDate DateTime?
  status        SurgeryRequestStatus @default(REQUESTED)
  invoice       Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId     String?
  invoiceItem   InvoiceItem?         @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  schedule TheatreSchedule?
  case     TheatreCase?

  @@index([encounterId])
  @@index([patientId])
  @@index([admissionId])
  @@index([wardId])
  @@index([status])
  @@index([createdAt])
  @@index([invoiceItemId])
}

model TheatreSchedule {
  id                    String         @id @default(uuid())
  surgeryRequest        SurgeryRequest @relation(fields: [surgeryRequestId], references: [id], onDelete: Cascade)
  surgeryRequestId      String         @unique
  theatreRoom           TheatreRoom    @relation(fields: [theatreRoomId], references: [id])
  theatreRoomId         String
  scheduledAt           DateTime
  estimatedDurationMins Int?
  surgeon               Staff          @relation("TheatreScheduleSurgeon", fields: [surgeonId], references: [id])
  surgeonId             String
  anaesthetist          Staff?         @relation("TheatreScheduleAnaesthetist", fields: [anaesthetistId], references: [id], onDelete: SetNull)
  anaesthetistId        String?
  scrubNurse            Staff?         @relation("TheatreScheduleScrubNurse", fields: [scrubNurseId], references: [id], onDelete: SetNull)
  scrubNurseId          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([scheduledAt])
  @@index([theatreRoomId])
  @@index([surgeonId])
}

model TheatreCase {
  id               String         @id @default(uuid())
  surgeryRequest   SurgeryRequest @relation(fields: [surgeryRequestId], references: [id], onDelete: Cascade)
  surgeryRequestId String         @unique
  performedBy      Staff?         @relation("TheatreCasePerformedBy", fields: [performedById], references: [id], onDelete: SetNull)
  performedById    String?
  startedAt        DateTime?
  endedAt          DateTime?
  findings         String?
  complications    String?
  operativeNotes   String?
  transferNotes    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  consumables TheatreCaseConsumable[]
  staff       TheatreCaseStaff[]
  operativeNoteRecords TheatreOperativeNote[]

  @@index([startedAt])
}

model TheatreOperativeNote {
  id              String      @id @default(uuid())
  theatreCase     TheatreCase @relation(fields: [theatreCaseId], references: [id], onDelete: Cascade)
  theatreCaseId   String
  authoredBy      Staff       @relation("TheatreOperativeNoteAuthoredBy", fields: [authoredById], references: [id])
  authoredById    String
  updatedBy       Staff?      @relation("TheatreOperativeNoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById     String?
  schemaVersion   Int         @default(1)
  answersJson     Json
  narrative       String      @default("")
  additionalNotes String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([theatreCaseId])
  @@index([authoredById])
  @@index([createdAt])
}

model TheatreCaseConsumable {
  id              String                @id @default(uuid())
  theatreCase     TheatreCase           @relation(fields: [theatreCaseId], references: [id], onDelete: Cascade)
  theatreCaseId   String
  consumable      Consumable            @relation(fields: [consumableId], references: [id], onDelete: Restrict)
  consumableId    String
  storeLocation   StoreLocation         @relation(fields: [storeLocationId], references: [id], onDelete: Restrict)
  storeLocationId String
  quantity        Int
  unitPrice       Decimal               @db.Decimal(12, 2)
  billable        Boolean               @default(true)
  invoice         Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoiceItem     InvoiceItem?          @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId   String?
  usageEvent      ConsumableUsageEvent? @relation(fields: [usageEventId], references: [id], onDelete: SetNull)
  usageEventId    String?
  createdAt       DateTime              @default(now())
  createdBy       Staff?                @relation("TheatreCaseConsumableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById     String?

  @@index([theatreCaseId])
  @@index([consumableId])
  @@index([storeLocationId])
}

model TheatreCaseStaff {
  id            String               @id @default(uuid())
  theatreCase   TheatreCase          @relation(fields: [theatreCaseId], references: [id], onDelete: Cascade)
  theatreCaseId String
  staff         Staff                @relation(fields: [staffId], references: [id], onDelete: Restrict)
  staffId       String
  role          TheatreCaseStaffRole
  createdAt     DateTime             @default(now())

  @@unique([theatreCaseId, staffId, role])
  @@index([theatreCaseId])
  @@index([staffId])
}

// ─────────────────────────────────────────────────────────────────────────────
// RADIOLOGY MODULE
// ─────────────────────────────────────────────────────────────────────────────

model RadiologyMachine {
  id        String            @id @default(uuid())
  name      String
  modality  RadiologyModality
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  schedules  RadiologySchedule[]
  procedures RadiologyProcedure[]

  @@index([modality])
  @@index([isActive])
}

model RadiologyOrder {
  id            String                 @id @default(uuid())
  patient       Patient                @relation(fields: [patientId], references: [id])
  patientId     String
  encounter     Encounter?             @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  encounterId   String?
  admission     Admission?             @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  admissionId   String?
  ward          Ward?                  @relation("RadiologyOrderWard", fields: [wardId], references: [id], onDelete: SetNull)
  wardId        String?
  requestedBy   Staff                  @relation("RadiologyOrderOrderedBy", fields: [requestedById], references: [id])
  requestedById String
  department    Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId  String?
  status        RadiologyRequestStatus @default(PENDING)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  pregnancy     Pregnancy?             @relation(fields: [pregnancyId], references: [id], onDelete: SetNull)
  pregnancyId   String?

  items RadiologyOrderItem[]

  @@index([patientId])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@index([pregnancyId])
  @@index([admissionId])
  @@index([wardId])
}

model RadiologyOrderItem {
  id                     String                 @id @default(uuid())
  order                  RadiologyOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId                String
  clinicalNotes          String?
  reasonForInvestigation String?
  priority               RadiologyPriority      @default(ROUTINE)
  scanType               RadiologyModality
  bodyPart               String?
  contrast               Boolean                @default(false)
  status                 RadiologyRequestStatus @default(PENDING)
  invoiceItem            InvoiceItem?           @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId          String?                @unique
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  schedule  RadiologySchedule?
  procedure RadiologyProcedure?
  images    RadiologyImage[]
  report    RadiologyStudyReport?

  @@index([orderId])
  @@index([status])
  @@index([priority])
  @@index([invoiceItemId])
}

model RadiologySchedule {
  id                   String             @id @default(uuid())
  radiologyOrderItem   RadiologyOrderItem @relation(fields: [radiologyOrderItemId], references: [id], onDelete: Cascade)
  radiologyOrderItemId String             @unique
  scheduledAt          DateTime
  radiographer         Staff?             @relation("RadiologyScheduleRadiographer", fields: [radiographerId], references: [id], onDelete: SetNull)
  radiographerId       String?
  machine              RadiologyMachine?  @relation(fields: [machineId], references: [id], onDelete: SetNull)
  machineId            String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([scheduledAt])
  @@index([radiographerId])
  @@index([machineId])
}

model RadiologyProcedure {
  id                   String             @id @default(uuid())
  radiologyOrderItem   RadiologyOrderItem @relation(fields: [radiologyOrderItemId], references: [id], onDelete: Cascade)
  radiologyOrderItemId String             @unique
  performedBy          Staff              @relation("RadiologyProcedurePerformedBy", fields: [performedById], references: [id])
  performedById        String
  machine              RadiologyMachine?  @relation(fields: [machineId], references: [id], onDelete: SetNull)
  machineId            String?
  startTime            DateTime
  endTime              DateTime?
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([performedById])
  @@index([machineId])
}

model RadiologyImage {
  id                   String             @id @default(uuid())
  radiologyOrderItem   RadiologyOrderItem @relation(fields: [radiologyOrderItemId], references: [id], onDelete: Cascade)
  radiologyOrderItemId String
  fileName             String
  filePath             String
  mimeType             String?
  fileSize             Int?
  uploadedBy           Staff              @relation("RadiologyImageUploadedBy", fields: [uploadedById], references: [id])
  uploadedById         String
  uploadedAt           DateTime           @default(now())

  @@index([radiologyOrderItemId])
}

model RadiologyStudyReport {
  id                   String             @id @default(uuid())
  radiologyOrderItem   RadiologyOrderItem @relation(fields: [radiologyOrderItemId], references: [id], onDelete: Cascade)
  radiologyOrderItemId String             @unique
  findings             String?
  impression           String?
  recommendations      String?
  severity             ReportSeverity?
  signedBy             Staff              @relation("RadiologyReportSignedBy", fields: [signedById], references: [id])
  signedById           String
  signedAt             DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([signedById])
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE MODULE (non-pharmacy / general supplies)
// ─────────────────────────────────────────────────────────────────────────────

enum StoreStockMovementType {
  ISSUE
  RECEIPT
  TRANSFER
  ADJUSTMENT
  RETURN
}

model StoreItemCategory {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items StoreItem[]
}

model StoreItem {
  id            String            @id @default(uuid())
  name          String
  sku           String?           @unique
  category      StoreItemCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId    String
  unitOfMeasure String
  reorderLevel  Decimal           @default(0) @db.Decimal(12, 2)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  stocks            StoreStock[]
  movements         StoreStockMovement[]
  @@index([categoryId])
  @@index([isActive])
}

model StoreLocation {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks        StoreStock[]
  movementsFrom StoreStockMovement[] @relation("StoreMovementFromLocation")
  movementsTo   StoreStockMovement[] @relation("StoreMovementToLocation")

  consumableBatches     ConsumableBatch[]
  consumableMovements   ConsumableMovement[]
  consumableUsageEvents ConsumableUsageEvent[]
  invoiceItemsFromStore      InvoiceItem[]               @relation("InvoiceItemStoreLocation")
  dialysisSessionConsumables DialysisSessionConsumable[]
  theatreCaseConsumables     TheatreCaseConsumable[]
}

model StoreStock {
  id             String        @id @default(uuid())
  item           StoreItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId         String
  location       StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId     String
  quantity       Decimal       @default(0) @db.Decimal(12, 2)
  unitCost       Decimal       @default(0) @db.Decimal(12, 2)
  lastMovementAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([itemId, locationId])
  @@index([itemId])
  @@index([locationId])
}

model StoreStockMovement {
  id             String                 @id @default(uuid())
  item           StoreItem              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemId         String
  fromLocation   StoreLocation?         @relation("StoreMovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  fromLocationId String?
  toLocation     StoreLocation?         @relation("StoreMovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  toLocationId   String?
  department     Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId   String?
  type           StoreStockMovementType
  quantity       Decimal                @db.Decimal(12, 2)
  unitCost       Decimal                @db.Decimal(12, 2)
  totalCost      Decimal                @db.Decimal(12, 2)
  reason         String?
  referenceType  String?
  referenceId    String?
  createdBy      Staff                  @relation("StoreStockMovementCreatedBy", fields: [createdById], references: [id])
  createdById    String
  createdAt      DateTime               @default(now())

  @@index([itemId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([departmentId])
  @@index([type])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PURCHASES MODULE
// ─────────────────────────────────────────────────────────────────────────────

enum PurchaseItemAllocationDirection {
  OUT
  IN
}

enum PurchasesLocationType {
  STORE
  WAREHOUSE
  DEPARTMENT
  COLD_ROOM
}

enum PurchasesOrderStatus {
  DRAFT
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum PurchasesStockTransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  REJECTED
}

enum RequisitionStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum RequestingDepartment {
  PHARMACY
  STORE
  PURCHASES
  LAB
  RADIOLOGY
  OTHER
}

enum PurchasesInventoryMovementType {
  PURCHASE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  RETURN
  EXPIRY_WRITEOFF
}

enum PurchasesMovementReferenceType {
  PURCHASE_ORDER
  TRANSFER
  GOODS_RECEIPT
  ADJUSTMENT
  REQUISITION
  INVOICE_ITEM
}

enum RequisitionLinePriority {
  NORMAL
  URGENT
  CRITICAL
}

enum RequisitionItemType {
  DRUG
  CONSUMABLE
  PURCHASE_ITEM
}

model PurchasesManufacturer {
  id          String   @id @default(uuid())
  name        String
  country     String?
  contactInfo Json?
  createdAt   DateTime @default(now())
  createdBy   Staff    @relation("PurchasesManufacturerCreatedBy", fields: [createdById], references: [id])
  createdById String

  items PurchaseItem[]

  @@index([name])
}

model PurchasesSupplier {
  id            String   @id @default(uuid())
  name          String
  licenseNumber String?
  contactInfo   Json?
  creditTerms   String?
  leadTimeDays  Int?
  rating        Int?
  isBlacklisted Boolean  @default(false)
  createdAt     DateTime @default(now())
  createdBy     Staff    @relation("PurchasesSupplierCreatedBy", fields: [createdById], references: [id])
  createdById   String

  batches        PurchaseItemBatch[]
  purchaseOrders PurchasesPurchaseOrder[]

  @@index([name])
}

model PurchaseItem {
  id              String               @id @default(uuid())
  itemName        String
  sku             String?
  category        String?
  description     String?
  manufacturer    PurchasesManufacturer? @relation(fields: [manufacturerId], references: [id])
  manufacturerId  String?
  unitOfMeasure   String?
  reorderLevel    Int                  @default(0)
  reorderQuantity Int                  @default(0)
  sellingPrice    Decimal              @default(0) @db.Decimal(12, 2)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  createdBy       Staff                @relation("PurchaseItemCreatedBy", fields: [createdById], references: [id])
  createdById     String
  updatedBy       Staff?               @relation("PurchaseItemUpdatedBy", fields: [updatedById], references: [id])
  updatedById     String?

  batches              PurchaseItemBatch[]
  purchaseOrderLines   PurchasesPurchaseOrderLine[]
  goodsReceiptItems    PurchasesGoodsReceiptItem[]
  inventoryMovements   PurchasesInventoryMovement[]
  requisitionLines     RequisitionLine[]
  invoiceItems         InvoiceItem[]
  purchaseItemReturns  InvoicePurchaseItemReturn[]

  @@index([manufacturerId])
  @@index([itemName])
  @@index([deletedAt])
}

model PurchasesLocation {
  id           String                @id @default(uuid())
  name         String
  locationType PurchasesLocationType
  description  String?
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  createdBy    Staff                 @relation("PurchasesLocationCreatedBy", fields: [createdById], references: [id])
  createdById  String
  updatedBy    Staff?                @relation("PurchasesLocationUpdatedBy", fields: [updatedById], references: [id])
  updatedById  String?
  staff        Staff?                @relation("PurchasesLocationStaff", fields: [staffId], references: [id])
  staffId      String?               @unique

  batchesFrom              PurchaseItemBatch[]          @relation("PurchaseItemBatchFromLocation")
  batchesTo                PurchaseItemBatch[]          @relation("PurchaseItemBatchToLocation")
  inventoryMovementsFrom   PurchasesInventoryMovement[] @relation("PurchasesInventoryMovementFromLocation")
  inventoryMovementsTo     PurchasesInventoryMovement[] @relation("PurchasesInventoryMovementToLocation")
  stockTransfersFrom       PurchasesStockTransfer[]     @relation("PurchasesStockTransferFromLocation")
  stockTransfersTo         PurchasesStockTransfer[]     @relation("PurchasesStockTransferToLocation")
  invoiceItems             InvoiceItem[]                @relation("InvoiceItemPurchasesLocation")
  purchaseItemReturns      InvoicePurchaseItemReturn[]  @relation("InvoicePurchaseItemReturnLocation")
}

model PurchaseItemBatch {
  id                String            @id @default(uuid())
  item              PurchaseItem      @relation(fields: [itemId], references: [id])
  itemId            String
  purchaseOrder     PurchasesPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId   String?
  supplier          PurchasesSupplier? @relation(fields: [supplierId], references: [id])
  supplierId        String?
  batchNumber       String?
  manufacturingDate DateTime?
  expiryDate        DateTime?
  quantityReceived  Int
  quantityRemaining Int?
  costPrice         Decimal?          @db.Decimal(12, 2)
  sellingPrice      Decimal?          @db.Decimal(12, 2)
  fromLocation      PurchasesLocation? @relation("PurchaseItemBatchFromLocation", fields: [fromLocationId], references: [id])
  fromLocationId    String?
  toLocation        PurchasesLocation? @relation("PurchaseItemBatchToLocation", fields: [toLocationId], references: [id])
  toLocationId      String?
  grn               PurchasesGoodsReceipt? @relation(fields: [grnId], references: [id])
  grnId             String?
  createdAt         DateTime          @default(now())

  movements     PurchasesInventoryMovement[]
  transferLines PurchasesStockTransferLine[]
  stockAllocations PurchaseItemStockAllocation[]

  @@index([itemId])
  @@index([supplierId])
  @@index([expiryDate])
  @@index([fromLocationId, toLocationId])
}

model PurchasesInventoryMovement {
  id             String                         @id @default(uuid())
  batch          PurchaseItemBatch              @relation(fields: [batchId], references: [id])
  batchId        String
  item           PurchaseItem                   @relation(fields: [itemId], references: [id])
  itemId         String
  fromLocation   PurchasesLocation?             @relation("PurchasesInventoryMovementFromLocation", fields: [fromLocationId], references: [id])
  fromLocationId String?
  toLocation     PurchasesLocation?             @relation("PurchasesInventoryMovementToLocation", fields: [toLocationId], references: [id])
  toLocationId   String?
  movementType   PurchasesInventoryMovementType
  quantity       Int
  referenceType  PurchasesMovementReferenceType
  referenceId    String
  performedBy    Staff                          @relation("PurchasesInventoryMovementPerformedBy", fields: [performedById], references: [id])
  performedById  String
  createdAt      DateTime                       @default(now())

  @@index([batchId])
  @@index([itemId])
  @@index([createdAt])
}

/// Per-batch audit of stock OUT (invoice) and IN (returns), with price snapshots.
model PurchaseItemStockAllocation {
  id                   String                          @id @default(uuid())
  batch                PurchaseItemBatch               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId              String
  direction            PurchaseItemAllocationDirection
  quantity             Int
  costPriceSnapshot    Decimal?                        @db.Decimal(12, 2)
  sellingPriceSnapshot Decimal?                        @db.Decimal(12, 2)
  invoiceItem          InvoiceItem?                    @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  invoiceItemId        String?
  performedBy          Staff                           @relation("PurchaseItemStockAllocationPerformedBy", fields: [performedById], references: [id])
  performedById        String
  createdAt            DateTime                        @default(now())

  @@index([batchId])
  @@index([invoiceItemId])
  @@index([createdAt])
}

model PurchasesPurchaseOrder {
  id           String               @id @default(uuid())
  supplier     PurchasesSupplier    @relation(fields: [supplierId], references: [id])
  supplierId   String
  status       PurchasesOrderStatus @default(DRAFT)
  totalAmount  Decimal              @default(0) @db.Decimal(12, 2)
  requisition  Requisition?         @relation(fields: [requisitionId], references: [id])
  requisitionId String?             @unique
  createdBy    Staff                @relation("PurchasesPurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdById  String
  approvedBy   Staff?               @relation("PurchasesPurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  approvedById String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  lines    PurchasesPurchaseOrderLine[]
  receipts PurchasesGoodsReceipt[]
  batches  PurchaseItemBatch[]

  @@index([supplierId])
  @@index([status])
}

model PurchasesPurchaseOrderLine {
  id              String               @id @default(uuid())
  purchaseOrder   PurchasesPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  item            PurchaseItem         @relation(fields: [itemId], references: [id])
  itemId          String
  quantity        Int
  unitCost        Decimal              @db.Decimal(12, 2)
  lineTotal       Decimal              @db.Decimal(12, 2)
  externalItemName String?

  @@index([purchaseOrderId])
  @@index([itemId])
}

model PurchasesGoodsReceipt {
  id              String               @id @default(uuid())
  purchaseOrder   PurchasesPurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String
  receivedBy      Staff                @relation("PurchasesGoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  receivedById    String
  receivedAt      DateTime             @default(now())
  notes           String?

  items   PurchasesGoodsReceiptItem[]
  batches PurchaseItemBatch[]
}

model PurchasesGoodsReceiptItem {
  id                String              @id @default(uuid())
  goodsReceipt      PurchasesGoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goodsReceiptId    String
  item              PurchaseItem        @relation(fields: [itemId], references: [id])
  itemId            String
  batchNumber       String?
  manufacturingDate DateTime?
  expiryDate        DateTime?
  quantityReceived  Int
  costPrice         Decimal             @db.Decimal(12, 2)
}

model PurchasesStockTransfer {
  id             String                     @id @default(uuid())
  fromLocation   PurchasesLocation          @relation("PurchasesStockTransferFromLocation", fields: [fromLocationId], references: [id])
  fromLocationId String
  toLocation     PurchasesLocation          @relation("PurchasesStockTransferToLocation", fields: [toLocationId], references: [id])
  toLocationId   String
  status         PurchasesStockTransferStatus @default(PENDING)
  createdBy      Staff                      @relation("PurchasesStockTransferCreatedBy", fields: [createdById], references: [id])
  createdById    String
  approvedBy     Staff?                     @relation("PurchasesStockTransferApprovedBy", fields: [approvedById], references: [id])
  approvedById   String?
  createdAt      DateTime                   @default(now())
  completedAt    DateTime?

  items PurchasesStockTransferLine[]
}

model PurchasesStockTransferLine {
  id              String               @id @default(uuid())
  stockTransfer   PurchasesStockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  stockTransferId String
  batch           PurchaseItemBatch    @relation(fields: [batchId], references: [id])
  batchId         String
  quantity        Int
}

model Requisition {
  id                   String               @id @default(uuid())
  requestingDepartment RequestingDepartment
  requestedBy          Staff                @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])
  requestedById        String
  status               RequisitionStatus    @default(PENDING)
  notes                String?
  rejectReason         String?
  approvedBy           Staff?               @relation("RequisitionApprovedBy", fields: [approvedById], references: [id])
  approvedById         String?
  rejectedBy           Staff?               @relation("RequisitionRejectedBy", fields: [rejectedById], references: [id])
  rejectedById         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  lines         RequisitionLine[]
  purchaseOrder PurchasesPurchaseOrder?

  @@index([status])
  @@index([requestingDepartment])
  @@index([createdAt])
}

model RequisitionLine {
  id            String                  @id @default(uuid())
  requisition   Requisition             @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  requisitionId String
  itemType      RequisitionItemType
  itemId        String
  itemName      String
  quantity      Int
  priority      RequisitionLinePriority @default(NORMAL)
  notes         String?
  purchaseItem  PurchaseItem?           @relation(fields: [purchaseItemId], references: [id])
  purchaseItemId String?

  @@index([requisitionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// HELTY DESKTOP (Flutter Windows .exe distribution)
// ─────────────────────────────────────────────────────────────────────────────

model HeltyDesktopRelease {
  id           String   @id @default(uuid())
  /// Semantic version string shown to clients (e.g. 1.2.3)
  version      String   @unique
  /// Stored filename, e.g. helty1.2.3.exe
  fileName     String
  /// Path under uploads/helty-desktop/ (not the tmp folder)
  relativePath String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Extra Windows .exe distribution files (besides the main Helty installer)
model HeltyDesktopExternalExecutable {
  id           String   @id @default(uuid())
  /// Stored filename, e.g. toolname.exe
  fileName     String   @unique
  /// Short human description shown in the UI
  description  String?
  /// Path under uploads/helty-desktop/ (not the tmp folder)
  relativePath String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// IMSH ANDROID (Flutter patient app .apk distribution)
// ─────────────────────────────────────────────────────────────────────────────

model ImshAndroidRelease {
  id           String   @id @default(uuid())
  /// Semantic version string shown to clients (e.g. 0.1.1)
  version      String   @unique
  /// Stored filename, e.g. imsh0.1.1.apk
  fileName     String
  /// Path under uploads/imsh-android/ (not the tmp folder)
  relativePath String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Scanned historical OPD encounters (pre-digital chart backfill)
model PatientArchivedEncounter {
  id                  String                             @id @default(uuid())
  patientId           String
  patient             Patient                            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterOccurredAt DateTime
  title               String?
  notes               String?
  uploadedById        String
  uploadedBy          Staff                              @relation("PatientArchivedEncounterUploadedBy", fields: [uploadedById], references: [id])
  createdAt           DateTime                           @default(now())
  updatedAt           DateTime                           @updatedAt
  documents           PatientArchivedEncounterDocument[]

  @@index([patientId, encounterOccurredAt])
}

model PatientArchivedEncounterDocument {
  id                  String                   @id @default(uuid())
  archivedEncounterId String
  archivedEncounter   PatientArchivedEncounter @relation(fields: [archivedEncounterId], references: [id], onDelete: Cascade)
  fileName            String
  filePath            String
  mimeType            String?
  fileSize            Int?
  uploadedAt          DateTime                 @default(now())

  @@index([archivedEncounterId])
}
