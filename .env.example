# Database Configuration
DATABASE_URL ="postgresql://vessel:FPOacna16178@localhost:5432/hospitaldb"

# Redis: set USE_REDIS=true only when Redis is running. When not true, REDIS_URL is ignored and
# presence/unread are in-memory (single Nest process; no cross-instance Socket.IO).
USE_REDIS=false
REDIS_URL="redis://127.0.0.1:6379"

# Internal chat / uploads (LAN base for URLs returned to clients)
PUBLIC_API_BASE_URL=http://localhost:3000
PRESENCE_AWAY_MINUTES=5
PRESENCE_OFFLINE_AFTER_MINUTES=60
CHAT_MAX_FILE_BYTES=52428800
ALLOW_CHAT_GUEST=false

# JWT Configuration
# Production / Coolify: must be a strong unique value per organization.
# Missing or example defaults cause startup failure when NODE_ENV=production.
JWT_SECRET=this_is_the_best_kept_secerte

# Email via Postmark (https://postmarkapp.com/developer). Server token from your Postmark server
# API Tokens tab; From must be a verified sender signature or domain.
# If POSTMARK_SERVER_TOKEN is unset, emails are skipped and logged (appointment + password reset).
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
POSTMARK_MESSAGE_STREAM=outbound

# SMS via Termii (https://developers.termii.com/messaging-api). Base URL is account-specific — copy
# from your Termii dashboard. Use channel dnd for transactional appointment messages (recommended).
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd
TERMII_TYPE=plain

# Optional: day-of appointment reminders (defaults to Africa/Lagos)
APPOINTMENT_REMINDER_TIMEZONE=Africa/Lagos
HOSPITAL_NAME="IBOM SPECIALIST HOSPITAL"

# Firebase Admin (FCM push). Path to service account JSON relative to cwd or absolute.
# Defaults to ./firebase-service-account.json when unset.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Staff ID used as createdBy/updatedBy for patient-portal appointment writes
PATIENT_PORTAL_SYSTEM_STAFF_ID=

# Server Configuration
NODE_ENV=development
PORT=3000

# HTTP request timeout in ms for large uploads. 0 = no timeout (recommended).
# Node 18+ defaults to 300000 (5 min), which kills slow remote .exe uploads.
HTTP_REQUEST_TIMEOUT_MS=0

# CORS Configuration  
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Optional: Rate limiting
THROTTLE_LIMIT=10
THROTTLE_TTL=60

# Helty Flutter Windows desktop uploads (override in production)
HELITY_DESKTOP_UPLOAD_PASSWORD=vesselinc
